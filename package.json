{
  "name": "serina-astro",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run hero:font",
    "dev": "astro dev",
    "prebuild": "npm run hero:font",
    "build": "astro build && node scripts/check-build.mjs && pagefind --site dist",
    "hero:font": "node scripts/build-hero-font.mjs",
    "emoji:import": "node scripts/import-emoji.mjs",
    "sticker:import": "node scripts/import-stickers.mjs",
    "admin": "node scripts/admin/server.mjs",
    "assets:editor": "node scripts/asset-editor.mjs",
    "preview": "astro preview",
    "check": "astro check && node scripts/contrast-audit.mjs",
    "lint": "biome ci .",
    "test": "vitest run",
    "contrast": "node scripts/contrast-audit.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/material-symbols": "^1.2.0",
    "@iconify-json/simple-icons": "^1.2.0",
    "astro": "^7.3.1",
    "astro-icon": "^1.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.13",
    "@iconify-json/lucide": "^1.2.149",
    "@nuxt/ui": "^4.12.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.63.0",
    "sharp": "0.35.4",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  }
}
