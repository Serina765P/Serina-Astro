---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
---

<BaseLayout title={`404 · ${SITE.title}`} description="页面不存在" pathname="/404.html">
  <div class="flex flex-col items-center py-20 text-center">
    <p class="bg-gradient-to-r from-accent-400 to-accent-600 bg-clip-text text-7xl font-bold text-transparent dark:from-accent-300 dark:to-accent-500">
      404
    </p>
    <p class="mt-4 text-neutral-500 dark:text-neutral-400">（´・ω・｀） 页面好像走丢了…</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-1.5 rounded-full bg-accent-500 px-5 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-600 dark:bg-accent-600 dark:hover:bg-accent-500"
    >
      <Icon name="material-symbols:home" class="size-4" />
      回到首页
    </a>
  </div>
</BaseLayout>
