---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/primitives/PageHeader.astro';
import Container from '../../components/primitives/Container.astro';
import { EMOJI, renderShuoshuoContent } from '../../lib/emoji';
import { STICKER } from '../../lib/sticker';
import { SITE } from '../../site.config';

const sets = [...new Map(EMOJI.map((emoji) => [emoji.set, emoji.setLabel])).entries()]
  .map(([key, label]) => ({ key, label, items: EMOJI.filter((emoji) => emoji.set === key) }));
const examples = [
  '今天状态不错，做完事情来喝茶 :afterglow_饮茶:',
  '这也太可爱了 :sweet_比心:',
  '发现一个好点子 :scclassic_灵光一现: 先记在这里。',
  'Live 结束后的心情 :ml_太好了:',
];
---

<BaseLayout title={`表情图鉴 · ${SITE.title}`} description="搜索、预览并复制站内自定义表情与贴纸短代码。" pathname="/emoji/">
  <Container width="standard" class="emoji-page">
    <section data-pagefind-ignore>
    <PageHeader title="表情图鉴" subtitle={`${EMOJI.length} 张表情 · ${STICKER.length} 张贴纸 · 选中即可复制短代码`} />

    <div class="emoji-tabs mt-6" role="tablist" aria-label="图鉴分类" data-tablist>
      <button class="emoji-tab" type="button" role="tab" id="emoji-tab" aria-controls="panel-emoji" aria-selected="true" data-tab="emoji">
        表情 <span class="emoji-tab-count">{EMOJI.length}</span>
      </button>
      <button class="emoji-tab" type="button" role="tab" id="sticker-tab" aria-controls="panel-sticker" aria-selected="false" tabindex="-1" data-tab="sticker">
        贴纸 <span class="emoji-tab-count">{STICKER.length}</span>
      </button>
    </div>

    <section class="emoji-composer mt-6" aria-labelledby="emoji-preview-title">
      <h2 id="emoji-preview-title" class="text-sm font-semibold text-ink">试写预览</h2>
      <p class="mt-1 text-xs text-sub">输入普通文字和短代码，例如 <code>:765pro_wink:</code> 或 <code>:ml_太好了:</code></p>
      <label class="sr-only" for="emoji-composer-input">输入要预览的内容</label>
      <textarea id="emoji-composer-input" rows="2" spellcheck="false">今天状态不错 :765pro_微笑: 做完事情来喝茶 :afterglow_饮茶: :ml_太好了:</textarea>
      <p class="emoji-preview-label">预览</p>
      <p id="emoji-composer-preview" class="emoji-preview" aria-live="polite"></p>
    </section>

    <p id="shortcode-copy-status" class="emoji-copy-status mt-2" role="status" aria-live="polite"></p>
    <label id="shortcode-manual-wrap" class="emoji-manual-wrap mt-2" hidden>
      <span>自动复制不可用，请手动复制：</span>
      <input id="shortcode-manual-copy" readonly aria-label="要复制的短代码" />
    </label>

    <section id="panel-emoji" role="tabpanel" aria-labelledby="emoji-tab">
      <section class="mt-9" aria-labelledby="emoji-samples-title">
        <h2 id="emoji-samples-title" class="text-sm font-semibold text-ink">行内效果</h2>
        <div class="emoji-examples mt-3">
          {examples.map((example) => <p set:html={renderShuoshuoContent(example)} />)}
        </div>
      </section>

      <section class="mt-10" aria-labelledby="emoji-catalog-title">
        <h2 id="emoji-catalog-title" class="text-sm font-semibold text-ink">全部表情</h2>
        <form id="emoji-filter" class="emoji-filter mt-3" role="search">
          <label class="emoji-search">
            <span class="sr-only">搜索表情</span>
            <Icon name="material-symbols:search" class="size-5" aria-hidden="true" />
            <input id="emoji-query" type="search" placeholder="搜索名称、套装或短代码…" autocomplete="off" />
          </label>
          <label class="emoji-set-select">
            <span class="sr-only">按套装筛选</span>
            <select id="emoji-set">
              <option value="">全部套装</option>
              {sets.map((set) => <option value={set.key}>{set.label}</option>)}
            </select>
          </label>
        </form>
        <p id="emoji-status" class="mt-3 text-xs text-sub" aria-live="polite">共 {EMOJI.length} 张表情</p>
        <div class="emoji-set-groups mt-4">
          {sets.map((set) => (
            <section class="emoji-set-group" data-emoji-set-group data-set={set.key} aria-labelledby={`emoji-set-${set.key}`}>
              <h3 id={`emoji-set-${set.key}`} class="emoji-set-heading">
                <span>{set.label}</span>
                <span class="emoji-set-count" data-set-count>{set.items.length} 张</span>
              </h3>
              <div class="emoji-grid" data-emoji-grid>
                {set.items.map((emoji) => (
                  <button
                    class="emoji-tile"
                    type="button"
                    data-emoji-tile
                    data-copy-code={emoji.code}
                    data-set={emoji.set}
                    data-search={`${emoji.code} ${emoji.label} ${emoji.setLabel} ${emoji.keywords.join(' ')}`.toLocaleLowerCase('zh-CN')}
                    aria-label={`复制 :${emoji.code}:，${emoji.label}`}
                    title={`复制 :${emoji.code}:`}
                  >
                    <img src={emoji.src} alt={emoji.label} width={emoji.width} height={emoji.height} loading="lazy" decoding="async" />
                    <span class="emoji-tile-label">{emoji.label}</span>
                    <code>:{emoji.code}:</code>
                  </button>
                ))}
              </div>
            </section>
          ))}
        </div>
        <p id="emoji-empty" class="empty-state mt-7" hidden>没有找到匹配的表情。</p>
      </section>
    </section>

    <section id="panel-sticker" role="tabpanel" aria-labelledby="sticker-tab" hidden>
      <section class="mt-9" aria-labelledby="sticker-catalog-title">
        <h2 id="sticker-catalog-title" class="text-sm font-semibold text-ink">全部贴纸</h2>
        <p class="mt-1 text-xs text-sub">悬停播放动画，单击复制短代码，右上角按钮下载动图。</p>
        <form id="sticker-filter" class="emoji-filter mt-3" role="search">
          <label class="emoji-search">
            <span class="sr-only">搜索贴纸</span>
            <Icon name="material-symbols:search" class="size-5" aria-hidden="true" />
            <input id="sticker-query" type="search" placeholder="搜索名称、台词或短代码…" autocomplete="off" />
          </label>
        </form>
        <p id="sticker-status" class="mt-3 text-xs text-sub" aria-live="polite">共 {STICKER.length} 张贴纸</p>
        <div id="sticker-grid" class="sticker-grid mt-4"></div>
        <noscript><p class="mt-4 text-sm text-sub">贴纸图鉴需要 JavaScript 才能显示。</p></noscript>
        <p id="sticker-empty" class="empty-state mt-7" hidden>没有找到匹配的贴纸。</p>
      </section>
    </section>
    </section>
  </Container>
</BaseLayout>

<script>
  import { renderShuoshuoContent } from '../../lib/emoji';
  import { STICKER, type CustomSticker } from '../../lib/sticker';

  type TabName = 'emoji' | 'sticker';

  const DOWNLOAD_ICON =
    '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M11 4h2v8.17l2.59-2.58L17 11l-5 5-5-5 1.41-1.41L11 12.17V4Z"/><path fill="currentColor" d="M5 18h14v2H5z"/></svg>';

  function escapeAttr(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function stickerMarkup(sticker: CustomSticker): string {
    const shortcode = `:${sticker.code}:`;
    const search =
      `${sticker.code} ${sticker.label} ${sticker.setLabel} ${sticker.keywords.join(' ')}`.toLocaleLowerCase(
        'zh-CN',
      );
    return `<article class="sticker-tile" data-sticker-tile data-search="${escapeAttr(search)}">
  <button class="sticker-copy" type="button" data-copy-code="${escapeAttr(sticker.code)}" aria-label="复制 ${escapeAttr(shortcode)}，${escapeAttr(sticker.label)}" title="复制 ${escapeAttr(shortcode)}">
    <img src="${escapeAttr(sticker.poster)}" data-animated="${escapeAttr(sticker.src)}" width="${sticker.width}" height="${sticker.height}" alt="${escapeAttr(sticker.label)}" loading="lazy" decoding="async" draggable="false" />
    <span class="sticker-tile-label">${escapeAttr(sticker.label)}</span>
    <code>${escapeAttr(shortcode)}</code>
  </button>
  <a class="sticker-download" href="${escapeAttr(sticker.src)}" download="${escapeAttr(sticker.code)}.webp" aria-label="下载动图：${escapeAttr(sticker.label)}" title="下载动图">${DOWNLOAD_ICON}</a>
</article>`;
  }

  function initializeEmojiPage() {
    const page = document.querySelector<HTMLElement>('.emoji-page');
    if (!page || page.dataset.bound === 'true') return;
    page.dataset.bound = 'true';

    const tabList = page.querySelector<HTMLElement>('[data-tablist]');
    const tabs = [...page.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels: Record<TabName, HTMLElement | null> = {
      emoji: page.querySelector<HTMLElement>('#panel-emoji'),
      sticker: page.querySelector<HTMLElement>('#panel-sticker'),
    };
    const input = page.querySelector<HTMLInputElement>('#emoji-query');
    const setFilter = page.querySelector<HTMLSelectElement>('#emoji-set');
    const status = page.querySelector<HTMLElement>('#emoji-status');
    const empty = page.querySelector<HTMLElement>('#emoji-empty');
    const tiles = [...page.querySelectorAll<HTMLButtonElement>('[data-emoji-tile]')];
    const groups = [...page.querySelectorAll<HTMLElement>('[data-emoji-set-group]')];
    const previewInput = page.querySelector<HTMLTextAreaElement>('#emoji-composer-input');
    const preview = page.querySelector<HTMLElement>('#emoji-composer-preview');
    const copyStatus = page.querySelector<HTMLElement>('#shortcode-copy-status');
    const manualWrap = page.querySelector<HTMLElement>('#shortcode-manual-wrap');
    const manualInput = page.querySelector<HTMLInputElement>('#shortcode-manual-copy');
    const stickerQuery = page.querySelector<HTMLInputElement>('#sticker-query');
    const stickerStatus = page.querySelector<HTMLElement>('#sticker-status');
    const stickerEmpty = page.querySelector<HTMLElement>('#sticker-empty');
    const stickerGrid = page.querySelector<HTMLElement>('#sticker-grid');
    let stickersReady = false;

    function tabName(value: string | undefined): TabName {
      return value === 'sticker' ? 'sticker' : 'emoji';
    }

    function renderStickers() {
      if (stickersReady || !stickerGrid) return;
      stickersReady = true;
      stickerGrid.innerHTML = STICKER.map(stickerMarkup).join('');
      bindStickerPlayback(stickerGrid);
      filterStickers();
    }

    function bindStickerPlayback(grid: HTMLElement) {
      const canPlay =
        window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!canPlay) return;
      for (const img of grid.querySelectorAll<HTMLImageElement>('img[data-animated]')) {
        const still = img.getAttribute('src') ?? '';
        const animated = img.dataset.animated ?? '';
        if (!still || !animated) continue;
        const play = () => {
          if (img.getAttribute('src') !== animated) img.setAttribute('src', animated);
        };
        const stop = () => {
          if (img.getAttribute('src') !== still) img.setAttribute('src', still);
        };
        const trigger = img.closest('.sticker-copy');
        trigger?.addEventListener('pointerenter', play);
        trigger?.addEventListener('pointerleave', stop);
        trigger?.addEventListener('focus', play);
        trigger?.addEventListener('blur', stop);
      }
    }

    function activateTab(name: TabName, syncUrl = true) {
      for (const tab of tabs) {
        const selected = tab.dataset.tab === name;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      }
      for (const [key, panel] of Object.entries(panels)) {
        if (panel) panel.hidden = key !== name;
      }
      if (name === 'sticker') renderStickers();
      if (!syncUrl) return;
      const url = new URL(window.location.href);
      if (name === 'sticker') url.searchParams.set('tab', 'sticker');
      else url.searchParams.delete('tab');
      window.history.replaceState(window.history.state, '', url);
    }

    function filterTiles() {
      const query = input?.value.trim().toLocaleLowerCase('zh-CN') ?? '';
      const selectedSet = setFilter?.value ?? '';
      let visibleCount = 0;
      for (const tile of tiles) {
        const visible =
          (!query || (tile.dataset.search ?? '').includes(query)) &&
          (!selectedSet || tile.dataset.set === selectedSet);
        tile.hidden = !visible;
        if (visible) visibleCount += 1;
      }
      for (const group of groups) {
        const groupTiles = [...group.querySelectorAll<HTMLButtonElement>('[data-emoji-tile]')];
        const groupCount = groupTiles.filter((tile) => !tile.hidden).length;
        const count = group.querySelector<HTMLElement>('[data-set-count]');
        group.hidden = groupCount === 0;
        if (count) count.textContent = `${groupCount} 张`;
      }
      if (status) status.textContent = `显示 ${visibleCount} / ${tiles.length} 张表情`;
      if (empty) empty.hidden = visibleCount > 0;
    }

    function filterStickers() {
      const query = stickerQuery?.value.trim().toLocaleLowerCase('zh-CN') ?? '';
      const stickerTiles = [...page!.querySelectorAll<HTMLElement>('[data-sticker-tile]')];
      let visibleCount = 0;
      for (const tile of stickerTiles) {
        const visible = !query || (tile.dataset.search ?? '').includes(query);
        tile.hidden = !visible;
        if (visible) visibleCount += 1;
      }
      if (stickerStatus)
        stickerStatus.textContent = query
          ? `找到 ${visibleCount} / ${stickerTiles.length} 张贴纸`
          : `共 ${stickerTiles.length} 张贴纸`;
      if (stickerEmpty) stickerEmpty.hidden = visibleCount > 0;
    }

    function updatePreview() {
      if (preview && previewInput) preview.innerHTML = renderShuoshuoContent(previewInput.value);
    }

    async function copyCode(code: string) {
      const shortcode = `:${code}:`;
      if (manualWrap) manualWrap.hidden = true;
      try {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable');
        await navigator.clipboard.writeText(shortcode);
        if (copyStatus) copyStatus.textContent = `已复制 ${shortcode}`;
      } catch {
        if (manualInput && manualWrap) {
          manualInput.value = shortcode;
          manualWrap.hidden = false;
          manualInput.focus();
          manualInput.select();
          if (copyStatus)
            copyStatus.textContent =
              '浏览器没有授予剪贴板权限，请使用 Ctrl+C（Mac 使用 ⌘C）复制选中的短代码。';
        }
      }
    }

    page.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const trigger = target?.closest<HTMLElement>('[data-copy-code]');
      if (!trigger) return;
      event.preventDefault();
      void copyCode(trigger.dataset.copyCode ?? '');
    });

    for (const tab of tabs) {
      tab.addEventListener('click', () => activateTab(tabName(tab.dataset.tab)));
    }
    tabList?.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      const current = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      const step = event.key === 'ArrowRight' ? 1 : -1;
      const next = tabs[(current + step + tabs.length) % tabs.length];
      if (!next) return;
      event.preventDefault();
      next.focus();
      activateTab(tabName(next.dataset.tab));
    });

    input?.addEventListener('input', filterTiles);
    setFilter?.addEventListener('change', filterTiles);
    stickerQuery?.addEventListener('input', filterStickers);
    previewInput?.addEventListener('input', updatePreview);

    const requested = new URL(window.location.href).searchParams.get('tab');
    activateTab(tabName(requested ?? undefined), false);
    filterTiles();
    updatePreview();
  }

  initializeEmojiPage();
  document.addEventListener('astro:page-load', initializeEmojiPage);
</script>

<style>
  @reference '../../styles/global.css';

  .emoji-tabs {
    @apply flex gap-1 rounded-xl border border-line bg-surface p-1;
  }
  .emoji-tab {
    @apply flex min-h-10 flex-1 items-center justify-center gap-2 rounded-lg px-3 text-sm font-medium text-sub transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wash-pink-deep;
    cursor: pointer;
  }
  .emoji-tab[aria-selected='true'] {
    @apply bg-surface-2 text-ink;
  }
  .emoji-tab-count {
    @apply rounded-full bg-chip px-2 py-0.5 text-[0.65rem] font-normal text-chip-fg;
  }
  .emoji-composer,
  .emoji-examples {
    @apply rounded-2xl border border-line bg-surface p-4;
  }
  @media (min-width: 40rem) {
    .emoji-composer,
    .emoji-examples {
      padding: 1.25rem;
    }
  }
  .emoji-composer textarea {
    @apply mt-3 block w-full resize-y rounded-xl border border-line bg-surface-2 px-3 py-2.5 text-sm leading-relaxed text-body outline-none transition-colors focus:border-wash-pink-deep;
  }
  .emoji-composer code {
    @apply rounded bg-surface-2 px-1 py-0.5 font-mono text-[0.9em] text-ink;
  }
  .emoji-preview-label {
    @apply mt-3 text-xs text-sub;
  }
  .emoji-preview {
    @apply mt-1 min-h-10 whitespace-pre-wrap break-words rounded-xl bg-surface-2 px-3 py-2 text-sm leading-relaxed text-body;
  }
  .emoji-examples p {
    @apply m-0 py-2 text-sm leading-relaxed text-body;
  }
  .emoji-examples p + p {
    @apply border-t border-line;
  }
  .emoji-filter {
    @apply flex flex-col gap-2 sm:flex-row;
  }
  .emoji-search {
    @apply flex min-h-11 flex-1 items-center gap-2 rounded-xl border border-line bg-surface px-3 text-sub focus-within:border-wash-pink-deep;
  }
  .emoji-search input,
  .emoji-set-select select {
    @apply min-w-0 flex-1 bg-transparent text-sm text-ink outline-none;
  }
  .emoji-search input::placeholder {
    color: var(--sub);
  }
  .emoji-set-select {
    @apply flex min-h-11 items-center rounded-xl border border-line bg-surface px-3 sm:min-w-48;
  }
  .emoji-set-select select {
    @apply cursor-pointer;
  }
  .emoji-copy-status {
    @apply min-h-5 text-xs text-wash-sage-deep;
  }
  .emoji-manual-wrap {
    @apply flex flex-wrap items-center gap-2 text-xs text-sub;
  }
  .emoji-manual-wrap input {
    @apply min-h-9 rounded-lg border border-line bg-surface px-2 font-mono text-ink;
  }
  .emoji-grid {
    @apply grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5;
  }
  .emoji-set-groups {
    @apply space-y-8;
  }
  .emoji-set-group {
    min-width: 0;
  }
  .emoji-set-heading {
    @apply mb-3 flex items-center gap-2 text-sm font-semibold text-ink;
  }
  .emoji-set-count {
    @apply rounded-full bg-chip px-2 py-0.5 text-[0.65rem] font-normal text-chip-fg;
  }
  .emoji-tile {
    @apply flex min-w-0 flex-col items-center rounded-xl border border-line bg-surface p-3 text-center transition-colors hover:border-wash-pink-deep hover:bg-surface-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wash-pink-deep;
    cursor: pointer;
  }
  .emoji-tile img {
    width: 4.25rem;
    height: 4.25rem;
    object-fit: contain;
  }
  .emoji-tile-label {
    @apply mt-2 max-w-full truncate text-xs font-medium text-ink;
  }
  .emoji-tile code {
    @apply mt-1 max-w-full truncate font-mono text-[0.62rem] text-sub;
  }
  .sticker-grid {
    @apply grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4;
  }
</style>

<style is:global>
  @reference '../../styles/global.css';

  /* 贴纸卡片由客户端渲染，拿不到 Astro 的 data-astro-cid 作用域标记，必须用全局样式 */
  .sticker-tile {
    position: relative;
    min-width: 0;
  }
  .sticker-copy {
    display: flex;
    height: 100%;
    width: 100%;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    border-radius: 0.75rem;
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 0.75rem;
    text-align: center;
    transition: border-color 0.15s, background-color 0.15s;
    cursor: pointer;
  }
  .sticker-copy:hover {
    border-color: var(--wash-pink-deep);
    background: var(--surface-2);
  }
  .sticker-copy:focus-visible {
    outline: 2px solid var(--wash-pink-deep);
    outline-offset: 2px;
  }
  .sticker-copy img {
    width: 100%;
    height: 5.75rem;
    object-fit: contain;
  }
  .sticker-tile-label {
    margin-top: 0.5rem;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink);
  }
  .sticker-copy code {
    margin-top: 0.25rem;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.62rem;
    color: var(--sub);
  }
  .sticker-download {
    position: absolute;
    right: 0.375rem;
    top: 0.375rem;
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--sub);
    transition: border-color 0.15s, color 0.15s;
  }
  .sticker-download:hover {
    border-color: var(--wash-pink-deep);
    color: var(--ink);
  }
</style>
