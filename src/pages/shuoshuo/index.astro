---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Giscus from '../../components/Giscus.astro';
import { SITE } from '../../site.config';

const items = (await getCollection('shuoshuo')).sort(
  (a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf(),
);

const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const linkify = (s: string) =>
  escapeHtml(s).replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener nofollow" class="text-accent-600 dark:text-accent-400">$1</a>');

const formatDateTime = (date: Date) =>
  date.toLocaleString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
---

<BaseLayout title={`说说 · ${SITE.title}`} description="B 站动态时间线" pathname="/shuoshuo/">
  <header class="mx-auto max-w-2xl">
    <h1 class="text-3xl tracking-[0.15em] text-ink">说说</h1>
    <p class="mt-2 text-sm text-sub">来自 B 站的动态，共 {items.length} 条</p>
  </header>

  <ol class="mx-auto mt-8 max-w-2xl space-y-6 border-l-2 border-line pl-5">
    {
      items.map((item) => (
        <li class="relative">
          <span
            aria-hidden="true"
            class="absolute top-6 -left-[1.7rem] size-2.5 rounded-full border-2 border-bg bg-wash-pink"
          />
          <article class="rounded-3xl border border-line bg-surface p-4 shadow-card sm:p-5">
            {item.data.title && (
              <h2 class="mb-1 text-base text-ink">{item.data.title}</h2>
            )}
            <p
              class="text-[0.95em] leading-relaxed break-words whitespace-pre-wrap text-body"
              set:html={linkify(item.data.content)}
            />

            {item.data.images.length > 0 && (
              <div
                class:list={[
                  'shuoshuo-images mt-3 grid gap-1.5',
                  item.data.images.length === 1 ? 'max-w-sm grid-cols-1' : 'grid-cols-3',
                ]}
              >
                {item.data.images.slice(0, 9).map((img) => (
                  <img
                    src={img.url}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    class="w-full cursor-zoom-in rounded-lg object-cover"
                    style={`aspect-ratio: ${img.width} / ${img.height};`}
                  />
                ))}
              </div>
            )}

            <footer class="mt-3 flex items-center gap-4 text-xs text-sub">
              <time datetime={item.data.published_at.toISOString()}>{formatDateTime(item.data.published_at)}</time>
              {item.data.like > 0 && (
                <span class="inline-flex items-center gap-1">
                  <Icon name="material-symbols:favorite" class="size-3.5" />
                  {item.data.like}
                </span>
              )}
              <a
                href={item.data.link}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1 transition-colors hover:text-accent-500 dark:hover:text-accent-300"
              >
                <Icon name="simple-icons:bilibili" class="size-3.5" />
                原动态
              </a>
            </footer>
          </article>
        </li>
      ))
    }
  </ol>

  <div class="mx-auto mt-10 max-w-2xl">
    <Giscus />
  </div>
</BaseLayout>
