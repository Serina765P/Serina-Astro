---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Giscus from '../../components/Giscus.astro';
import PageHeader from '../../components/primitives/PageHeader.astro';
import Container from '../../components/primitives/Container.astro';
import { SITE } from '../../site.config';
import { TZ } from '../../lib/utils';

// `satisfies GetStaticPaths` 是 Astro 推断 Astro.props 的前提：不标注时 paginate 参数
// 隐式 any，Astro 推不出 page 类型，astro check 会整页报 14 个 never/any 错误。
export const getStaticPaths = (async ({ paginate }) => {
  const items = (await getCollection('shuoshuo')).sort(
    (a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf(),
  );
  // 每页 10 条；[...page] 生成 /shuoshuo、/shuoshuo/2、/shuoshuo/3…
  return paginate(items, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const items = page.data;

const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const linkify = (s: string) =>
  escapeHtml(s).replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener nofollow" class="text-wash-pink-deep hover:text-wash-rose-deep">$1</a>');

const formatDateTime = (date: Date) =>
  date.toLocaleString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: TZ,
  });
---

<BaseLayout title={`说说 · ${SITE.title}`} description="碎碎念时间线" pathname={page.url.current}>
  <Container width="narrow">
    <PageHeader title="说说" subtitle={`共 ${page.total} 条说说`} />

    <ol class="mt-8 space-y-6 border-l-2 border-line pl-5">
      {
        items.map((item) => (
          <li class="relative">
            <span
              aria-hidden="true"
              class="absolute top-6 -left-[1.7rem] size-2.5 rounded-full border-2 border-bg bg-wash-pink"
            />
            <article class="rounded-3xl border border-line bg-surface p-4 shadow-card sm:p-5">
              {item.data.title && (
                <h2 class="mb-1 text-base text-ink">{item.data.title}</h2>
              )}
              <p
                class="text-[0.95em] leading-relaxed break-words whitespace-pre-wrap text-body"
                set:html={linkify(item.data.content)}
              />

              {item.data.images.length > 0 && (
                <div
                  class:list={[
                    'shuoshuo-images mt-3 grid gap-1.5',
                    item.data.images.length === 1 ? 'max-w-sm grid-cols-1' : 'grid-cols-3',
                  ]}
                >
                  {item.data.images.slice(0, 9).map((img, i) => (
                    <img
                      src={img.url}
                      alt={`配图 ${i + 1}`}
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      class="w-full cursor-zoom-in rounded-lg object-cover"
                      style={`aspect-ratio: ${img.width} / ${img.height};`}
                    />
                  ))}
                </div>
              )}

              <footer class="mt-3 flex items-center gap-4 text-xs text-sub">
                <time datetime={item.data.published_at.toISOString()}>{formatDateTime(item.data.published_at)}</time>
                {item.data.like > 0 && (
                  <span class="inline-flex items-center gap-1">
                    <Icon name="material-symbols:favorite" class="size-3.5" />
                    {item.data.like}
                  </span>
                )}
                {
                  item.data.link && (
                    <a
                      href={item.data.link}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-1 transition-colors hover:text-wash-pink-deep"
                    >
                      <Icon name="simple-icons:bilibili" class="size-3.5" />
                      原动态
                    </a>
                  )
                }
              </footer>
            </article>
          </li>
        ))
      }
    </ol>

    {
      page.lastPage > 1 && (
        <nav class="mt-10 flex items-center justify-center gap-4 text-sm" aria-label="分页">
          {page.url.prev ? (
            <a
              href={page.url.prev}
              class="rounded-full border border-line bg-surface px-4 py-1.5 text-body transition-colors hover:text-wash-pink-deep"
            >
              ← 上一页
            </a>
          ) : (
            <span class="rounded-full px-4 py-1.5 text-sub opacity-40">← 上一页</span>
          )}
          <span class="text-sub tabular-nums">
            {page.currentPage} / {page.lastPage}
          </span>
          {page.url.next ? (
            <a
              href={page.url.next}
              class="rounded-full border border-line bg-surface px-4 py-1.5 text-body transition-colors hover:text-wash-pink-deep"
            >
              下一页 →
            </a>
          ) : (
            <span class="rounded-full px-4 py-1.5 text-sub opacity-40">下一页 →</span>
          )}
        </nav>
      )
    }

    <div class="mt-10">
      <Giscus />
    </div>
  </Container>
</BaseLayout>
