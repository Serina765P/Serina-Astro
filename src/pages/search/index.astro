---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/primitives/PageHeader.astro';
import Container from '../../components/primitives/Container.astro';
import { SITE } from '../../site.config';
---

<BaseLayout title={`搜索 · ${SITE.title}`} description="全站搜索" pathname="/search/">
  <Container width="narrow" id="search-app">
    <PageHeader title="搜索" class="mb-6" />

    <div class="relative">
      <Icon
        name="material-symbols:search"
        class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-sub"
        aria-hidden="true"
      />
      <input
        id="search-input"
        type="search"
        name="q"
        placeholder="搜索文章与资源…"
        aria-label="搜索全站"
        enterkeyhint="search"
        autocomplete="off"
        class="w-full rounded-full border border-line bg-surface py-2.5 pr-4 pl-11 text-sm text-ink transition-colors placeholder:text-sub focus:border-wash-pink-deep"
      />
    </div>

    <p id="search-status" class="mt-3 hidden text-xs text-sub tabular-nums" aria-live="polite"></p>
    <ul id="search-results" class="mt-4 space-y-3 pb-16"></ul>
  </Container>
</BaseLayout>

<script is:inline>
  (function () {
    // ClientRouter 换页会重跑本脚本；防重复绑定导致监听器累积（与 Giscus 同一模式）。
    // 幂等标记挂 <html>（documentElement 不随换页替换）
    if (document.documentElement.dataset.searchBound === 'true') return;
    document.documentElement.dataset.searchBound = 'true';

    var pagefind = null;

    function getPagefind() {
      // pagefind 索引是构建后产物，用 is:inline + 原生动态 import，
      // 避免 Vite 对内联脚本的预加载包装导致运行时错误（__VITE_PRELOAD__ 未替换）
      if (!pagefind) {
        pagefind = import('/pagefind/pagefind.js');
      }
      return pagefind;
    }

    function initSearch() {
      var root = document.getElementById('search-app');
      if (!root || root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      var input = root.querySelector('#search-input');
      var resultsEl = root.querySelector('#search-results');
      var statusEl = root.querySelector('#search-status');
      var timer;
      var seq = 0; // 请求序号：仅最新一次请求可写 DOM，防先发后至覆盖新结果

      function syncUrl(query) {
        var url = new URL(location.href);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      }

      function run() {
        var query = input.value.trim();
        var current = ++seq;
        resultsEl.innerHTML = '';
        syncUrl(query);
        if (!query) {
          statusEl.hidden = true;
          return;
        }
        statusEl.hidden = false;
        statusEl.textContent = '搜索中…';

        getPagefind()
          .then(function (pf) {
            return pf.search(query);
          })
          .then(function (search) {
            if (current !== seq) return;
            statusEl.textContent = '共 ' + search.results.length + ' 个结果';
            var top = search.results.slice(0, 20);
            return Promise.all(top.map(function (r) { return r.data(); }));
          })
          .then(function (results) {
            if (!results || current !== seq) return;
            results.forEach(function (result) {
              var li = document.createElement('li');
              // 与 <Card lift={false}> 同一份 recipe（结果项本身不是链接，故不抬升）
              li.className = 'card-surface p-4';
              var a = document.createElement('a');
              a.href = result.url;
              a.className =
                'block text-ink transition-colors hover:text-wash-pink-deep';
              a.textContent = (result.meta && result.meta.title) || result.url;
              var excerpt = document.createElement('div');
              excerpt.className =
                'mt-1 text-sm text-sub [&_mark]:rounded-sm [&_mark]:bg-accent-200 [&_mark]:text-accent-900 dark:[&_mark]:bg-accent-700 dark:[&_mark]:text-accent-50';
              excerpt.innerHTML = result.excerpt;
              li.append(a, excerpt);
              resultsEl.appendChild(li);
            });
            if (results.length === 0) {
              statusEl.textContent = '没有找到相关内容 (´･_･`) 试试换个关键词，或去标签页逛逛';
            }
          })
          .catch(function () {
            if (current !== seq) return;
            statusEl.hidden = false;
            statusEl.textContent = '搜索索引仅在构建后可用（npm run build 后预览）';
          });
      }

      input.addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(run, 200);
      });

      // 从 ?q= 恢复查询（刷新/分享/前进后退均可用）
      function restore() {
        var q = new URLSearchParams(location.search).get('q') || '';
        if (q && q !== input.value) {
          input.value = q;
          run();
        }
      }
      restore();
      // popstate 只绑一次；回调内实时查当前页的输入框，避免引用已脱离文档的旧元素
      if (document.documentElement.dataset.searchPopBound !== 'true') {
        document.documentElement.dataset.searchPopBound = 'true';
        window.addEventListener('popstate', function () {
          var current = document.getElementById('search-input');
          if (!current) return;
          var q = new URLSearchParams(location.search).get('q') || '';
          if (q && q !== current.value) {
            current.value = q;
            current.dispatchEvent(new Event('input'));
          }
        });
      }
    }

    document.addEventListener('astro:page-load', initSearch);
  })();
</script>
