---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';
---

<BaseLayout title={`搜索 · ${SITE.title}`} description="全站搜索" pathname="/search/">
  <div id="search-app" class="mx-auto max-w-2xl">
    <header class="mb-6">
      <h1 class="text-3xl tracking-[0.15em] text-ink">搜索</h1>
    </header>

    <div class="relative">
      <Icon
        name="material-symbols:search"
        class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-sub"
      />
      <input
        id="search-input"
        type="search"
        placeholder="搜索文章与资源…"
        autofocus
        class="w-full rounded-full border border-line bg-surface py-2.5 pr-4 pl-11 text-sm text-ink outline-none transition-colors placeholder:text-sub focus:border-wash-pink-deep"
      />
    </div>

    <p id="search-status" class="mt-3 hidden text-xs text-sub tabular-nums" aria-live="polite"></p>
    <ul id="search-results" class="mt-4 space-y-3 pb-16"></ul>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var pagefind = null;

    function getPagefind() {
      // pagefind 索引是构建后产物，用 is:inline + 原生动态 import，
      // 避免 Vite 对内联脚本的预加载包装导致运行时错误（__VITE_PRELOAD__ 未替换）
      if (!pagefind) {
        pagefind = import('/pagefind/pagefind.js');
      }
      return pagefind;
    }

    function initSearch() {
      var root = document.getElementById('search-app');
      if (!root || root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      var input = root.querySelector('#search-input');
      var resultsEl = root.querySelector('#search-results');
      var statusEl = root.querySelector('#search-status');
      var timer;

      function run() {
        var query = input.value.trim();
        resultsEl.innerHTML = '';
        if (!query) {
          statusEl.hidden = true;
          return;
        }
        getPagefind()
          .then(function (pf) {
            return pf.search(query);
          })
          .then(function (search) {
            statusEl.hidden = false;
            statusEl.textContent = '共 ' + search.results.length + ' 个结果';
            var top = search.results.slice(0, 20);
            return Promise.all(top.map(function (r) { return r.data(); }));
          })
          .then(function (results) {
            results.forEach(function (result) {
              var li = document.createElement('li');
              li.className =
                'rounded-3xl border border-line bg-surface p-4 shadow-card';
              var a = document.createElement('a');
              a.href = result.url;
              a.className =
                'block text-ink transition-colors hover:text-wash-pink-deep';
              a.textContent = (result.meta && result.meta.title) || result.url;
              var excerpt = document.createElement('div');
              excerpt.className =
                'mt-1 text-sm text-sub [&_mark]:rounded-sm [&_mark]:bg-accent-200 [&_mark]:text-accent-900 dark:[&_mark]:bg-accent-700 dark:[&_mark]:text-accent-50';
              excerpt.innerHTML = result.excerpt;
              li.append(a, excerpt);
              resultsEl.appendChild(li);
            });
            if (results.length === 0) {
              statusEl.textContent = '没有找到相关内容 (´･_･`)';
            }
          })
          .catch(function () {
            statusEl.hidden = false;
            statusEl.textContent = '搜索索引仅在构建后可用（npm run build 后预览）';
          });
      }

      input.addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(run, 200);
      });
    }

    document.addEventListener('astro:page-load', initSearch);
  })();
</script>
