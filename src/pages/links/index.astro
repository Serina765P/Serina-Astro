---
import { Icon } from 'astro-icon/components';
import PageLayout from '../../layouts/PageLayout.astro';
import Card from '../../components/primitives/Card.astro';
import TagChip from '../../components/primitives/TagChip.astro';
import { SITE_META } from '../../site.config';
---

<PageLayout title="友情链接" description="欢迎交换友链" showComments>
  <p>欢迎交换友链 ✨</p>

  <ul class="not-prose mt-6 grid gap-3 sm:grid-cols-2">
    {
      SITE_META.friendLinks.map((link) => (
        <li>
          <Card as="a" href={link.href} target="_blank" rel="noopener" class="flex items-center gap-2.5 px-5 py-4">
            <Icon name="material-symbols:link" class="size-4 shrink-0 text-sub" />
            <span class="text-body">{link.name}</span>
          </Card>
        </li>
      ))
    }
  </ul>

  <h2>找到我</h2>
  <ul class="not-prose mt-4 flex flex-wrap gap-2">
    {
      SITE_META.social.map((s) => (
        <li>
          <TagChip href={s.href} label={s.name} icon={s.icon} size="social" target="_blank" rel="noopener" />
        </li>
      ))
    }
  </ul>

  <h2>交换友链</h2>
  <p>如果你想添加友链，请在评论区留言，格式如下：</p>
  <pre><code>名称：xxx
链接：https://xxx.com
简介：xxx</code></pre>
</PageLayout>
