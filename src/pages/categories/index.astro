---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';
import PageHeader from '../../components/primitives/PageHeader.astro';
import { categorySlug } from '../../site.config';
import { SITE } from '../../site.config';

const posts = await getCollection('posts');

const categories = new Map<string, { name: string; count: number }>();
for (const post of posts) {
  for (const name of post.data.categories) {
    const entry = categories.get(name) ?? { name, count: 0 };
    entry.count++;
    categories.set(name, entry);
  }
}
const sorted = [...categories.values()].sort((a, b) => b.count - a.count);
---

<BaseLayout title={`分类 · ${SITE.title}`} description="文章分类" pathname="/categories/">
  <Container width="standard">
    <PageHeader title="分类" />

    {
      sorted.length === 0 ? (
        <p class="empty-state mt-6">暂无分类。</p>
      ) : (
        <ul class="category-list" aria-label="全部分类" data-motion>
          {sorted.map(({ name, count }) => (
            <li data-motion-item>
              <a href={`/categories/${categorySlug(name)}/`} class="category-row">
                <span class="category-name">{name}</span>
                <span class="category-count">{count} 篇</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Container>
</BaseLayout>

<style>
  /* 分类页（D3）：六个分类不值得两列卡片 —— 卡片网格会把 6 行内容摊成 3 行空白。
     单列索引行：名字在左、篇数在右，行间不加分隔线，只用留白与 hover 底色。 */
  .category-list {
    display: grid;
    gap: 0.25rem;
    margin-inline: -0.75rem;
  }

  .category-row {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.875rem;
    border-radius: 0;
    padding: 0.875rem 0.75rem;
    transition: background-color 180ms ease;
  }

  .category-row:hover,
  .category-row:focus-visible {
    background: var(--brand-wash);
  }

  .category-name {
    color: var(--ink);
    font-size: var(--text-lead);
    line-height: 1.4;
  }

  .category-count {
    margin-left: auto;
    color: var(--sub);
    font-size: var(--text-note);
    font-variant-numeric: tabular-nums;
  }
</style>
