---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/primitives/Card.astro';
import PageHeader from '../../components/primitives/PageHeader.astro';
import { categoryColor, categorySlug } from '../../site.config';
import { SITE } from '../../site.config';

const posts = await getCollection('posts');

const categories = new Map<string, { name: string; count: number }>();
for (const post of posts) {
  for (const name of post.data.categories) {
    const entry = categories.get(name) ?? { name, count: 0 };
    entry.count++;
    categories.set(name, entry);
  }
}
const sorted = [...categories.values()].sort((a, b) => b.count - a.count);
---

<BaseLayout title={`分类 · ${SITE.title}`} description="文章分类" pathname="/categories/">
  <PageHeader title="分类" />

  <ul class="grid gap-3 sm:grid-cols-2">
    {
      sorted.map(({ name, count }) => (
        <li>
          <Card
            as="a"
            href={`/categories/${categorySlug(name)}/`}
            class="flex items-center justify-between px-5 py-4"
          >
            <span class="flex items-center gap-2.5 text-body">
              <span aria-hidden="true" class="size-2.5 rounded-full" style={`background:${categoryColor(name)}`}></span>
              {name}
            </span>
            <span class="text-sm text-sub tabular-nums">{count} 篇</span>
          </Card>
        </li>
      ))
    }
  </ul>
</BaseLayout>
