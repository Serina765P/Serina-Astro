---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/primitives/PageHeader.astro';
import { tagSlug } from '../../site.config';
import { SITE } from '../../site.config';

const posts = await getCollection('posts');

const tags = new Map<string, { name: string; count: number }>();
for (const post of posts) {
  for (const name of post.data.tags) {
    const entry = tags.get(name) ?? { name, count: 0 };
    entry.count++;
    tags.set(name, entry);
  }
}
const sorted = [...tags.values()].sort((a, b) => b.count - a.count);

// 按文章数量决定字号（2.6rem → 0.95rem 之间），克制的标签云
const max = Math.max(...sorted.map((t) => t.count), 1);
const min = Math.min(...sorted.map((t) => t.count), 1);
const fontSize = (count: number) => {
  if (max === min) return '1rem';
  const t = (count - min) / (max - min);
  return `${(0.95 + t * 0.85).toFixed(2)}rem`;
};
---

<BaseLayout title={`标签 · ${SITE.title}`} description="文章标签" pathname="/tags/">
  <PageHeader title="标签" />

  <ul class="flex flex-wrap gap-x-5 gap-y-3" aria-label="全部标签">
    {
      sorted.map(({ name, count }) => (
        <li>
          <a
            href={`/tags/${tagSlug(name)}/`}
            class="inline-flex items-baseline gap-1.5 text-wash-pink-deep transition-colors hover:text-wash-rose-deep"
            style={`font-size: ${fontSize(count)};`}
          >
            <span class="font-medium"># {name}</span>
            <span class="text-xs text-sub tabular-nums">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
