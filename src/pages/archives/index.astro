---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/primitives/Container.astro';
import PageHeader from '../../components/primitives/PageHeader.astro';
import { formatDate, yearInShanghai } from '../../lib/utils';
import { SITE } from '../../site.config';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = yearInShanghai(post.data.date);
  const list = byYear.get(year) ?? [];
  list.push(post);
  byYear.set(year, list);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title={`归档 · ${SITE.title}`} description="全部文章归档" pathname="/archives/">
  <Container width="standard">
    <PageHeader title="归档" subtitle={`共 ${posts.length} 篇文章`} />

    <div class="space-y-10">
      {
        years.map((year) => (
          <section aria-label={`${year} 年文章`}>
            <h2 class="sticky top-[var(--header-h)] z-sticky-head -mx-4 bg-bg/90 px-4 py-1.5 text-xl tracking-[0.15em] text-accent-600 backdrop-blur-sm">
              {year}
            </h2>
            <ul class="mt-3 divide-y divide-line">
              {byYear.get(year)!.map((post) => (
                <li>
                  <a
                    href={`/posts/${post.id}/`}
                    class="group flex items-baseline justify-between gap-4 rounded-2xl px-2 py-2.5 transition-colors hover:bg-surface"
                  >
                    <span class="min-w-0 truncate text-[0.95em] text-body transition-colors group-hover:text-wash-pink-deep">
                      {post.data.title}
                    </span>
                    <time
                      datetime={post.data.date.toISOString()}
                      class="shrink-0 text-xs text-sub tabular-nums"
                    >
                      {formatDate(post.data.date)}
                    </time>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </Container>
</BaseLayout>
