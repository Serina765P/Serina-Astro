---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagChip from '../components/primitives/TagChip.astro';
import Container from '../components/primitives/Container.astro';
import { formatDate } from '../lib/utils';
import { stripShuoshuoTags } from '../lib/shuoshuo';
import { HERO, SITE, tagSlug } from '../site.config';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recent = [...posts]
  .sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned) || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

// 最近一条说说（截断展示，完整内容在 /shuoshuo/）
const latestSay = (await getCollection('shuoshuo')).sort(
  (a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf(),
)[0];

// 高频标签
const tagCount = new Map<string, number>();
for (const post of posts) for (const t of post.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const topTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 9);

// 建站天数：以最早一篇文章的日期起算
const oldest = posts[posts.length - 1]?.data.date;
const days = oldest ? Math.max(1, Math.ceil((Date.now() - oldest.valueOf()) / 86400000)) : 1;

const shuoshuoCount = (await getCollection('shuoshuo')).length;
// 先压缩空白再统一截断与判断（原文换行多时长度会虚高，导致误加省略号）
const sayPlain = latestSay ? stripShuoshuoTags(latestSay.data.content).replace(/\s+/g, ' ') : '';
const sayText = sayPlain.slice(0, 88) + (sayPlain.length > 88 ? '…' : '');
const sayTime = latestSay ? formatDate(latestSay.data.published_at) : '';
---

<BaseLayout title={`${SITE.title} · ${SITE.subtitle}`} description={SITE.description} pathname="/" mainClass="py-0">
  <!-- 个人主页已独立存在：首页保留轻量身份提示，把首屏空间还给文章。 -->
  <section class="border-b border-line bg-surface/60">
    <Container width="standard" class="flex items-center gap-4 py-8 sm:gap-5 sm:py-10">
      <Image
        src={HERO.avatar}
        alt={`${SITE.author} 的头像`}
        width={128}
        height={128}
        layout="fixed"
        loading="eager"
        fetchpriority="high"
        class="size-16 shrink-0 rounded-2xl object-cover shadow-card sm:size-20"
      />
      <div class="min-w-0">
        <p class="text-xs font-medium tracking-[0.18em] text-wash-mist-deep">{SITE.title}</p>
        <h1 class="mt-1 font-hero text-3xl tracking-[0.12em] text-ink [text-wrap:balance] sm:text-4xl">
          {SITE.subtitle}
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-sub">{SITE.description}</p>
      </div>
    </Container>
  </section>

  <Container width="standard" class="flex flex-col pb-16">
    <section class="order-1 pt-10 sm:pt-12">
      <!-- 最近文章（spine 卡） -->
      <div class="sec-head">
        <h2>最近写下的</h2>
        <span>RECENT · 按时间</span>
      </div>
      {
        recent.some((post) => post.data.pinned) && (
          <p class="mb-4 text-sm text-sub">置顶文章会优先显示，其他文章仍按发布时间排列。</p>
        )
      }
      <div class="space-y-4">
        {recent.map((post) => <PostCard post={post} />)}
      </div>
      {
        posts.length > recent.length && (
            <a
              href="/archives/"
              class="mt-7 inline-block text-sm text-wash-pink-deep transition-colors hover:text-wash-rose-deep"
            >
              查看全部 {posts.length} 篇 →
            </a>
        )
      }
    </section>

    <section class="order-2 mt-12">
    <!-- 便当盒信息区 -->
    <div class="sec-head">
      <h2>小站速览</h2>
      <span>BENTO · 一格一格装满日常</span>
    </div>
    <div class="bento">
      <div class="cell stat"><div class="v">{posts.length}<small> 篇</small></div><div class="k">文章</div></div>
      <div class="cell stat"><div class="v">{shuoshuoCount}<small> 条</small></div><div class="k">说说</div></div>
      <div class="cell stat"><div class="v">{days}<small> 天</small></div><div class="k">持续更新</div></div>
      <div class="cell stat"><div class="v">{tagCount.size}<small> 个</small></div><div class="k">标签</div></div>

      {
        latestSay && (
          <div class="cell say-cell">
            <div class="label">
              <span class="ico bg-wash-sand" aria-hidden="true">💬</span>最近的说说
              <a href="/shuoshuo/" class="more">全部 →</a>
            </div>
            <div class="bubble">{sayText}</div>
            <div class="time">{sayTime} · {latestSay.data.type === 'MAIL' ? '来自邮件' : '来自哔哩哔哩'}</div>
          </div>
        )
      }

      <div class="cell cloud-cell lift">
        <div class="label"><span class="ico bg-wash-mist" aria-hidden="true">◈</span>标签云</div>
        <div class="mt-3 flex flex-wrap content-start gap-2">
          {
            topTags.map(([name]) => (
              <TagChip href={`/tags/${tagSlug(name)}/`} label={name} size="cloud" />
            ))
          }
        </div>
      </div>

      <div class="cell quick-cell lift">
        <div class="label"><span class="ico bg-wash-pink" aria-hidden="true">⚡</span>快捷入口</div>
        <div class="mt-3 grid flex-1 grid-cols-4 gap-2.5">
          <a href="/search/" class="quick"><Icon name="material-symbols:search" class="size-5" aria-hidden="true" />搜索</a>
          <a href="/shuoshuo/" class="quick"><Icon name="material-symbols:chat" class="size-5" aria-hidden="true" />说说</a>
          <a href="/rss.xml" class="quick"><Icon name="material-symbols:send" class="size-5" aria-hidden="true" />RSS</a>
          <a href="https://github.com/Serina765P" target="_blank" rel="noopener" class="quick"><Icon name="simple-icons:github" class="size-5" aria-hidden="true" />GitHub</a>
        </div>
      </div>
    </div>
    </section>
  </Container>
</BaseLayout>

<style>
  @reference '../styles/global.css';

  .sec-head {
    @apply mb-5 flex flex-wrap items-baseline gap-x-4 gap-y-1;
  }
  .sec-head h2 {
    @apply text-xl tracking-[0.16em] text-ink;
  }
  .sec-head span {
    @apply text-xs tracking-[0.14em] text-sub;
  }

  /* 便当盒 */
  .bento {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: auto auto auto;
    grid-template-areas:
      's1 s2 s3 s4'
      'say say say say'
      'cloud cloud quick quick';

    /* 中小屏保持统计数据的可扫读密度；内容卡片仍然跨满整行。 */
    @variant max-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      grid-template-areas:
        's1 s2'
        's3 s4'
        'say say'
        'cloud cloud'
        'quick quick';
    }
  }
  /* 抬升只给可交互的格子（标签云/快捷入口），非交互格子保持安静 —— 可供性要诚实 */
  .bento > .cell {
    @apply rounded-2xl border border-line bg-surface p-5 shadow-card;
    min-height: 0;
  }
  .bento > .cell.lift {
    @apply transition-[transform,box-shadow] hover:-translate-y-0.5 hover:shadow-card-hover;
  }
  .cell:nth-of-type(1) { grid-area: s1; }
  .cell:nth-of-type(2) { grid-area: s2; }
  .cell:nth-of-type(3) { grid-area: s3; }
  .cell:nth-of-type(4) { grid-area: s4; }
  .cloud-cell { grid-area: cloud; }
  .quick-cell { grid-area: quick; }

  .stat {
    @apply flex min-h-28 flex-col justify-center gap-0.5 bg-surface-2 text-center;
  }
  .stat .v {
    @apply text-4xl text-ink;
  }
  .stat .v small {
    @apply text-sm text-sub;
  }
  .stat .k {
    @apply text-xs tracking-[0.3em] text-sub;
  }

  .label {
    @apply flex items-center gap-2 text-[11px] tracking-[0.18em] text-sub;
  }
  .label .ico {
    @apply grid size-5.5 shrink-0 place-items-center rounded-lg text-[11px] text-on-wash;
  }
  .label .more {
    @apply ml-auto text-xs text-wash-pink-deep tracking-normal;
  }
  .say-cell { grid-area: say; }
  .say-cell .bubble {
    @apply mt-3 rounded-3xl rounded-bl-lg bg-surface-2 px-5 py-3.5 text-sm leading-relaxed text-body;
  }
  .say-cell .time {
    @apply mt-2.5 text-xs text-sub;
  }
  .quick {
    @apply flex flex-col items-center justify-center gap-1.5 rounded-2xl bg-chip px-2 py-3.5 text-xs font-medium text-chip-fg transition-colors hover:bg-chip-hover hover:text-chip-fg-hover;
  }

  /* 窄屏折叠（S14）：让每格回到自动排布。
     必须留在样式块最后 —— 与上面的 .cell:nth-of-type(n) 同特异性（0,2,0），靠源序压过它们 */
  .bento > .cell {
    @variant max-bento {
      grid-area: auto;
    }
  }
</style>
