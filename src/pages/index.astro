---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SidebarCard from '../components/SidebarCard.astro';
import { HERO, SITE } from '../site.config';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recent = posts.slice(0, 10);
---

<BaseLayout
  title={`${SITE.title} · ${SITE.subtitle}`}
  description={SITE.description}
  pathname="/"
  mainClass="w-full"
>
  <!-- 全幅 hero：底图铺满视口，中央头像光晕 + 渐变标题（呼应个人主页 serinap.top） -->
  <section
    class="relative flex h-[400px] items-center justify-center overflow-hidden sm:h-[460px]"
  >
    <img
      src={HERO.image}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full scale-105 object-cover"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-neutral-50/40 via-neutral-50/75 to-neutral-50 dark:from-neutral-900/40 dark:via-neutral-900/75 dark:to-neutral-900"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-neutral-50 to-transparent dark:from-neutral-900"
    >
    </div>

    <div class="relative flex flex-col items-center px-6 text-center">
      <div class="relative">
        <div
          aria-hidden="true"
          class="absolute -inset-2 rounded-full bg-gradient-to-tr from-accent-400/50 via-fuchsia-400/40 to-purple-400/50 blur-lg"
        >
        </div>
        <img
          src={HERO.avatar}
          alt={`${SITE.author} 的头像`}
          class="relative size-24 rounded-full object-cover shadow-xl sm:size-28"
        />
      </div>
      <h1 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">
        <span
          class="bg-gradient-to-r from-accent-500 via-fuchsia-500 to-purple-500 bg-clip-text text-transparent dark:from-accent-400 dark:via-fuchsia-400 dark:to-purple-400"
        >
          {SITE.title}
        </span>
      </h1>
      <p
        class="mt-3 text-xs font-medium tracking-[0.4em] text-neutral-500 sm:text-sm dark:text-neutral-400"
      >
        {SITE.subtitle}
      </p>
      <p class="mt-4 max-w-xl text-sm text-neutral-600 dark:text-neutral-300">
        {SITE.description}
      </p>
      <div class="mt-5 flex items-center gap-2 text-xs text-neutral-400 dark:text-neutral-500">
        <Icon name="material-symbols:article" class="size-4" />
        <span>{posts.length} 篇文章 · 持续更新中</span>
      </div>
    </div>
  </section>

  <div class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_280px]">
      <section aria-labelledby="recent-heading">
        <h2
          id="recent-heading"
          class="text-lg font-semibold text-neutral-900 dark:text-neutral-100"
        >
          最近文章
        </h2>
        <div class="mt-4 space-y-4">
          {recent.map((post) => <PostCard post={post} />)}
        </div>
        {
          posts.length > recent.length && (
            <a
              href="/archives/"
              class="mt-6 inline-block text-sm text-accent-600 transition-colors hover:text-accent-500 dark:text-accent-400 dark:hover:text-accent-300"
            >
              查看全部 {posts.length} 篇 →
            </a>
          )
        }
      </section>

      <SidebarCard />
    </div>
  </div>
</BaseLayout>
