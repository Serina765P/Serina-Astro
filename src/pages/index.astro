---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Container from '../components/primitives/Container.astro';
import { HERO, SITE, SITE_META } from '../site.config';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recent = [...posts]
  .sort(
    (a, b) =>
      Number(b.data.pinned) - Number(a.data.pinned) || b.data.date.valueOf() - a.data.date.valueOf(),
  )
  .slice(0, 6);

// 小站索引（B 版）：只留一行文字，不再拉最近的说说正文与标签云 —— 首页的第一个任务
// 是让人看到文章列表，索引里的入口导航栏都有。
const shuoshuoCount = (await getCollection('shuoshuo')).length;
const tagTotal = new Set(posts.flatMap((post) => post.data.tags)).size;
---

<BaseLayout
  title={`${SITE.title} · ${SITE.subtitle}`}
  description={SITE.description}
  pathname="/"
  mainClass="py-0"
  heroFont
>
  <!-- 首屏：平色底取代原来的 linear-gradient（屋规：无渐变）。标题 / 说明在首屏直接可读，
       不参与入场隐藏 —— 它们是访客判断「这是不是我要看的站」的唯一依据。 -->
  <section class="home-hero" aria-labelledby="home-title">
    <Container width="standard" class="hero-inner">
      <div class="hero-copy">
        <h1 id="home-title" class="hero-title text-display text-ink">{SITE.subtitle}</h1>
        <!-- 站点说明用 site-info.json 的完整一句：首屏必须有一行 ≥18px 的话说清这是什么
             （SITE.description 只有一句 slogan，probe 的 name-only-title 认不出来）。
             20px 的 --ink 取代原来的 15px --sub。 -->
        <p class="hero-description text-lead text-ink">{SITE_META.description}</p>
      </div>
      <div class="hero-portrait" data-parallax>
        <Image
          src={HERO.avatar}
          alt={`${SITE.author} 的头像`}
          width={160}
          height={160}
          layout="fixed"
          loading="eager"
          fetchpriority="high"
          class="hero-avatar"
        />
        <span class="hero-caption text-note">芹菜P / SERINA</span>
      </div>
    </Container>
  </section>

  <Container width="standard">
    <section id="recent" class="recent-section" aria-labelledby="recent-title" data-motion>
      <div class="section-heading" data-motion-item>
        <h2 id="recent-title" class="text-heading text-ink">最近写下的</h2>
        {
          posts.length > recent.length && (
            <a href="/archives/" class="archive-link text-note">
              查看全部 {posts.length} 篇文章{' '}
              <Icon name="material-symbols:arrow-forward" class="size-4" aria-hidden="true" />
            </a>
          )
        }
      </div>
      <div class="post-list">
        {
          recent.map((post) => (
            <div data-motion-item>
              <PostCard post={post} variant="directory" />
            </div>
          ))
        }
      </div>
    </section>
  </Container>

  <!-- 小站索引：只保留一行统计与入口。原先的「统计四连 + 最近说说 + 其他页面 + 常用标签」
       四块把首页当仪表盘布置，区块数比文章还多，视觉重心也压过了正文。 -->
  <section class="site-index" aria-label="站点索引">
    <Container width="standard">
      <p class="index-line">
        {posts.length} 篇文章 · {shuoshuoCount} 条说说 · {tagTotal} 个标签 · <a href="/search/">搜索</a> · <a
          href="/shuoshuo/">说说</a
        > · <a href="/rss.xml">RSS</a> · <a
          href="https://github.com/Serina765P"
          target="_blank"
          rel="noopener">GitHub</a
        >
      </p>
    </Container>
  </section>
</BaseLayout>

<style>
  @reference '../styles/global.css';

  /* 平色底 + 一档色阶：hero 用 --brand-wash，与吸顶头（--bg）分出色阶，不需要 1px 分隔线 */
  .home-hero {
    background: var(--brand-wash);
  }

  /* 首屏节奏：上下留白走 clamp 的自有档位，hero 与下一节之间的距离归 --space-section */
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12rem;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .hero-copy {
    max-width: 36rem;
  }

  .hero-title {
    font-family: var(--font-hero);
    /* 显示级衬线需要一点字距撑住骨架，但 0.08em 在 60px 上会把字拆散；0.04em 是上限 */
    letter-spacing: 0.04em;
    text-wrap: balance;
  }

  .hero-description {
    max-width: 36rem;
    margin-top: 1.25rem;
  }

  .hero-portrait {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }

  /* 头像描边走 --line 的 1px outline（不是 box-shadow：探针把静止态投影判 FAIL），
     内侧 0.35rem 的 --surface 留白环保留 */
  .hero-avatar {
    position: relative;
    z-index: 1;
    width: 9rem;
    height: 9rem;
    border: 0.35rem solid var(--surface);
    border-radius: 50%;
    outline: 1px solid var(--line);
    outline-offset: 2px;
    object-fit: cover;
  }


  .hero-caption {
    color: var(--sub);
    font-weight: 600;
    letter-spacing: normal;
  }

  /* 首屏与「最近写下的」之间的唯一间距来源 */
  .recent-section {
    padding-top: var(--space-section);
  }

  /* 分区内部间距一律小于 --space-section（D3 的层级）：标题到第一行 ≈ 1.75rem，
     其中 1.25rem 由 PostCard 的行内 padding-top 承担，这里只补 0.5rem。 */
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
  }

  /* 目录式列表：行间不画线，也不留 gap —— 分隔由 PostCard 的 1.25rem 行内边距承担 */
  .post-list {
    display: grid;
  }

  .archive-link {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    gap: 0.4rem;
    color: var(--brand-strong);
    font-weight: 600;
    transition: color 180ms ease;
  }

  /* 小站索引：只有一行文字，不铺底色。原先进这里的是四块「仪表盘」（统计 / 最近说说 /
     其他页面 / 常用标签），区块数比文章列表还多，视觉重心压过了正文；色带再把它抬成
     一个「区块」，去掉底色后它就只是一行注脚。 */
  .site-index {
    margin-top: max(var(--space-section), 5rem);
  }

  .index-line {
    margin: 0;
    color: var(--sub);
    font-size: var(--text-base);
  }

  .index-line a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .index-line a:hover {
    color: var(--brand-strong);
    border-color: var(--brand-strong);
  }

  .archive-link:hover {
    color: var(--brand);
  }

  /* 55rem = 容器断点。scoped style 的裸媒体查询取不到 Tailwind 的 --breakpoint-*，
     所以这里写它的唯一真值。 */
  @media (max-width: 55rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) 9rem;
      gap: 2rem;
    }

    .hero-avatar {
      width: 7.5rem;
      height: 7.5rem;
    }

  }

  @media (max-width: 48rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) 6.5rem;
      gap: 1rem;
      padding-block: 1.75rem;
    }

    .hero-avatar {
      width: 5.75rem;
      height: 5.75rem;
      border-width: 0.25rem;
    }


  }

  @media (max-width: 36rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
      padding-block: 1.5rem 1.75rem;
    }

    .hero-portrait {
      grid-row: 2;
      display: flex;
      justify-content: flex-start;
      gap: 1rem;
    }

    .hero-copy {
      grid-row: 1;
    }

    .hero-description {
      max-width: none;
    }

    .hero-avatar {
      width: 4.5rem;
      height: 4.5rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .archive-link,
    .index-line a {
      transition: none;
    }
  }
</style>
