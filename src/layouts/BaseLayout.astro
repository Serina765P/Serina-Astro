---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import ReadingProgress from '../components/ReadingProgress.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogType?: 'website' | 'article';
  pathname?: string;
  /** 覆盖 <main> 的布局类。默认只留纵向留白 —— 页面级宽度一律交给 <Container>（P1-4） */
  mainClass?: string;
  readingProgress?: boolean;
}

const {
  title,
  description,
  keywords,
  ogType,
  pathname,
  mainClass = 'py-8 sm:py-10',
  readingProgress = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <script is:inline>
      (function () {
        function applyTheme() {
          var stored = null;
          try {
            stored = localStorage.getItem('theme');
          } catch (e) {
            /* 隐私模式等 storage 不可用时回退到系统偏好 */
          }
          var dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
          // 从 CSS token 读取浏览器 chrome 底色，避免主题色在 JS 中重复维护
          var themeColor = document.querySelector('meta[name="theme-color"]');
          if (themeColor) {
            requestAnimationFrame(function () {
              var bg = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
              if (bg) themeColor.setAttribute('content', bg);
            });
          }
        }
        applyTheme();
        // 监听器只在首次执行时绑定：本脚本换页后会被 ClientRouter 重跑，
        // 幂等标记挂 <html>（documentElement 不随换页替换）防止监听器累积
        if (document.documentElement.dataset.themeBound === 'true') return;
        document.documentElement.dataset.themeBound = 'true';
        // ClientRouter 换页会换掉 <html> 的 class，换页后必须重新应用主题
        document.addEventListener('astro:after-swap', applyTheme);
        // smooth 会让换页回顶变成动画，动画期间视口停在内容之外（页面下方出现大量空白）
        document.addEventListener('astro:before-swap', function () {
          document.documentElement.style.scrollBehavior = 'auto';
        });
        document.addEventListener('astro:page-load', function () {
          document.documentElement.style.scrollBehavior = '';
        });
      })();
    </script>
    <BaseHead title={title} description={description} keywords={keywords} ogType={ogType} pathname={pathname} />
    <!-- 字体（均走 ZeoSeven CDN，OFL-1.1）：
         正文 IBM Plex Sans SC（item 389，同族四档字重：Regular400 默认 / Medium500 / SemiBold600 加粗与小标题 / Bold700 大标题）；
         首页 hero 朝华标题明朝体（item 2101，单字重 Bold，家族 ZhaohuaMinA Bold，global.css --font-hero） -->
    <link rel="preconnect" href="https://fontsapi.zeoseven.com" crossorigin />
    <link rel="stylesheet" href="https://fontsapi.zeoseven.com/389/main/result.css" />
    <link rel="stylesheet" href="https://fontsapi.zeoseven.com/389/medium/result.css" />
    <link rel="stylesheet" href="https://fontsapi.zeoseven.com/389/semi-bold/result.css" />
    <link rel="stylesheet" href="https://fontsapi.zeoseven.com/389/bold/result.css" />
    <link rel="stylesheet" href="https://fontsapi.zeoseven.com/2101/main/result.css" />
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <div class="page-loading" data-page-loading>
      <div class="page-loading__content" role="status" aria-live="polite">
        <span class="page-loading__person" aria-hidden="true">
          <svg class="page-loading__fallback" viewBox="0 0 64 96" fill="none">
            <circle cx="32" cy="12" r="8" fill="currentColor" />
            <path d="m30 25-8 22 14 8m-9-30 17 12 8-8m-22 18-10 24m20-16 12 18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="7" />
          </svg>
          <picture class="page-loading__image">
            <source
              srcset="https://millionlive-theaterdays.idolmaster-official.jp/assets/data/webp/common/load/17/sd.png.webp"
              type="image/webp"
            />
            <img
              src="https://millionlive-theaterdays.idolmaster-official.jp/assets/img/common/load/17/sd.png"
              alt=""
              onload="this.closest('.page-loading__person').classList.add('has-image')"
            />
          </picture>
        </span>
        <span class="page-loading__label">Now Loading...</span>
      </div>
    </div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-skip focus:rounded-full focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:text-ink focus:shadow-card"
    >
      跳到正文
    </a>
    <Header />
    <main id="main" tabindex="-1" data-pagefind-body class:list={['mx-auto w-full flex-1', mainClass]}>
      <slot />
    </main>
    <Footer />
    <Lightbox />
    {readingProgress && <ReadingProgress />}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (root.__pageLoadingState) return;
        var state = { timer: 0, visible: false, activeSignal: null };
        root.__pageLoadingState = state;

        function setVisible(visible) {
          state.visible = visible;
          var overlay = document.querySelector('[data-page-loading]');
          if (overlay) overlay.classList.toggle('is-visible', visible);
        }

        document.addEventListener('astro:before-preparation', function (event) {
          window.clearTimeout(state.timer);
          state.activeSignal = event.signal;
          setVisible(false);
          state.timer = window.setTimeout(function () {
            if (state.activeSignal && !state.activeSignal.aborted) setVisible(true);
          }, 140);
        });

        document.addEventListener('astro:after-swap', function () {
          if (state.visible) setVisible(true);
        });

        function finish() {
          window.clearTimeout(state.timer);
          state.timer = 0;
          state.activeSignal = null;
          setVisible(false);
        }

        document.addEventListener('astro:page-load', finish);
      })();
    </script>
  </body>
</html>
