---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogType?: 'website' | 'article';
  pathname?: string;
}

const { title, description, keywords, ogType, pathname } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <BaseHead title={title} description={description} keywords={keywords} ogType={ogType} pathname={pathname} />
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6 sm:py-10">
      <slot />
    </main>
    <Footer />
    <Lightbox />
  </body>
</html>
