---
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import Toc from '../components/Toc.astro';
import Giscus from '../components/Giscus.astro';
import BackToTop from '../components/BackToTop.astro';
import ImasAlbum from '../components/skins/ImasAlbum.astro';
import ArticleLicense from '../components/ArticleLicense.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Card from '../components/primitives/Card.astro';
import TagChip from '../components/primitives/TagChip.astro';
import Container from '../components/primitives/Container.astro';
import { categoryFillClass, categorySlug, tagSlug, SITE } from '../site.config';
import { formatDate, formatCount, readingTime, wordcount } from '../lib/utils';
import type { PostLicense } from '../lib/post-frontmatter';

interface PostRef {
  id: string;
  data: { title: string };
}

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      date: Date;
      updated?: Date;
      tags: string[];
      categories: string[];
      description?: string;
      keywords?: string[];
      skin?: 'imas-album';
      license?: PostLicense;
      toc?: boolean;
    };
  };
  Content: (...args: any[]) => any;
  headings: { depth: number; slug: string; text: string }[];
  /** 按日期排序后的相邻文章（newer 较新，older 较旧） */
  newer?: PostRef | null;
  older?: PostRef | null;
}

const { post, Content, headings, newer = null, older = null } = Astro.props;
const { data } = post;
const words = wordcount(post.body ?? '');
const minutes = readingTime(post.body ?? '');
const category = data.categories[0];
const showToc = data.toc !== false && !data.categories.includes('小游戏');
---

<BaseLayout
  title={`${data.title} · ${SITE.title}`}
  description={data.description}
  keywords={data.keywords}
  ogType="article"
  pathname={`/posts/${post.id}/`}
  mainClass="py-8 sm:py-10"
  readingProgress
>
  {
    data.skin === 'imas-album' && <ImasAlbum />
  }
  <CodeBlock />

  <Container width="wide" class="flex justify-center gap-10">
    <article class="min-w-0 max-w-4xl flex-1">
      <!-- 文章面板（D3）：无描边、无圆角、无阴影 —— 用 --surface 比页面 --bg 高一档色阶
           划出阅读区，边界不再靠 1px 线条。 -->
      <div class="post-panel bg-surface p-5 sm:p-8 lg:p-10">
        <header class="mb-9">
          <!-- 分类 chip 从 h1 上方移到元信息行（屋规：标题上方不放小标签）。放在 h1 之后
               既保住了分类入口，也不再被探针判成 eyebrow。 -->
          <h1 class="post-title text-ink [text-wrap:balance]">
            {data.title}
          </h1>

          <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-note text-sub">
            {
              category && (
                <a
                  href={`/categories/${categorySlug(category)}/`}
                  class:list={[
                    'inline-flex items-center rounded-full px-2.5 py-0.5 text-note text-cat-on transition-opacity hover:opacity-85',
                    categoryFillClass(category),
                  ]}
                >
                  {category}
                </a>
              )
            }
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:calendar-month" class="size-3.5" aria-hidden="true" />
              <time datetime={data.date.toISOString()}>发布于 {formatDate(data.date)}</time>
            </span>
            {
              data.updated && data.updated.getTime() !== data.date.getTime() && (
                <span class="inline-flex items-center gap-1">
                  <Icon name="material-symbols:article" class="size-3.5" aria-hidden="true" />
                  <time datetime={data.updated.toISOString()}>更新于 {formatDate(data.updated)}</time>
                </span>
              )
            }
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:schedule" class="size-3.5" aria-hidden="true" />
              约 {minutes} 分钟 · {formatCount(words)} 字
            </span>
          </div>

          {
            data.tags.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="标签">
                {data.tags.map((tag) => (
                  <li>
                    <TagChip href={`/tags/${tagSlug(tag)}/`} label={`# ${tag}`} />
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <Prose>
          <Content />
        </Prose>

        {data.license === 'original' && <ArticleLicense title={data.title} id={post.id} />}
      </div>

      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="上一篇下一篇">
        {
          older ? (
            <Card as="a" href={`/posts/${older.id}/`} class="group p-4">
              <span class="flex items-center gap-1 text-note text-sub">
                <Icon name="material-symbols:keyboard-arrow-left" class="size-4" aria-hidden="true" />
                上一篇
              </span>
              <span class="mt-1 line-clamp-1 block text-base text-ink group-hover:text-wash-pink-deep">
                {older.data.title}
              </span>
            </Card>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <Card as="a" href={`/posts/${newer.id}/`} class="group p-4 text-right">
              <span class="flex items-center justify-end gap-1 text-note text-sub">
                下一篇
                <Icon name="material-symbols:keyboard-arrow-right" class="size-4" aria-hidden="true" />
              </span>
              <span class="mt-1 line-clamp-1 block text-base text-ink group-hover:text-wash-pink-deep">
                {newer.data.title}
              </span>
            </Card>
          )
        }
      </nav>

      <Giscus />
    </article>

    <!-- TOC：≥lg 是吸顶侧栏，<lg 是底部悬浮 pill —— 两种形态都在 Toc 内部（同一份树数据）。
         aside 用 display:contents 把布局盒子摘掉：窄屏时它不参与 flex 布局、不吃 gap 宽度，
         宽屏时恢复成 w-56 的一栏。 -->
    {
      showToc && (
        <aside class="contents lg:block lg:w-56 lg:shrink-0">
          <Toc headings={headings} />
        </aside>
      )
    }
  </Container>
  <BackToTop />
</BaseLayout>

<style>
  /* 文章标题是五档字号（D2）的唯一例外，原因写在前面：display 档是给 6–10 字的页面标题
     准备的，31 字的中文长标题在 60px 下断成 3 行反而更难读。长标题的换行约束优先于
     刻度整齐：390 宽 28px，1440 宽封顶 40px，大约每行 17–20 个汉字。 */
  .post-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
  }

  /* 正文列（--measure = 36em = 576px @16px 正文）与标题共用一条左边缘。面板取 46rem：
     1440 宽实测文章栏 840px、面板 736px（居中，两侧各 52px）、内容盒 656px（lg:p-10 各 40px）。
     不把面板铺满 840px —— 否则正文右侧会空出 264px 的整列死区；也不只居中正文：
     正文一旦居中，标题与元信息的左边缘就会和正文错开约 40px，读起来像排版事故。
     代价是正文右侧留 80px 余量（36em 量度之外的面板余宽），是行尾之后的留白，不是空列。 */
  .post-panel {
    max-width: 46rem;
    margin-inline: auto;
  }
</style>
