---
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import Toc from '../components/Toc.astro';
import Giscus from '../components/Giscus.astro';
import ImasAlbum from '../components/skins/ImasAlbum.astro';
import { categoryColor, categorySlug, tagSlug, SITE } from '../site.config';
import { formatDate, formatCount, readingTime, wordcount } from '../lib/utils';

interface PostRef {
  id: string;
  data: { title: string };
}

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      date: Date;
      updated?: Date;
      tags: string[];
      categories: string[];
      description?: string;
      skin?: 'imas-album';
    };
  };
  Content: (...args: any[]) => any;
  headings: { depth: number; slug: string; text: string }[];
  /** 按日期排序后的相邻文章（newer 较新，older 较旧） */
  newer?: PostRef | null;
  older?: PostRef | null;
}

const { post, Content, headings, newer = null, older = null } = Astro.props;
const { data } = post;
const words = wordcount(post.body ?? '');
const minutes = readingTime(post.body ?? '');
const category = data.categories[0];
---

<BaseLayout
  title={`${data.title} · ${SITE.title}`}
  description={data.description}
  ogType="article"
  pathname={`/posts/${post.id}/`}
  mainClass="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-10"
>
  {
    data.skin === 'imas-album' && <ImasAlbum />
  }

  <div class="relative">
    <article class="min-w-0">
      <!-- 文章面板：Apple 式大标题 + 舒适栏宽 -->
      <div class="rounded-3xl border border-line bg-surface p-6 shadow-card sm:p-10 lg:p-12">
        <header class="mb-9">
          {
            category && (
              <a
                href={`/categories/${categorySlug(category)}/`}
                class="inline-flex items-center rounded-full px-3.5 py-1 text-xs text-white transition-opacity hover:opacity-85"
                style={`background:${categoryColor(category)}`}
              >
                {category}
              </a>
            )
          }
          <h1 class="mt-4 text-2xl leading-snug tracking-[0.04em] text-ink sm:text-[2rem]">
            {data.title}
          </h1>

          <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-sub">
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:calendar-month" class="size-3.5" />
              <time datetime={data.date.toISOString()}>发布于 {formatDate(data.date)}</time>
            </span>
            {
              data.updated && data.updated.getTime() !== data.date.getTime() && (
                <span class="inline-flex items-center gap-1">
                  <Icon name="material-symbols:article" class="size-3.5" />
                  <time datetime={data.updated.toISOString()}>更新于 {formatDate(data.updated)}</time>
                </span>
              )
            }
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:schedule" class="size-3.5" />
              约 {minutes} 分钟 · {formatCount(words)} 字
            </span>
          </div>

          {
            data.tags.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="标签">
                {data.tags.map((tag) => (
                  <li>
                    <a
                      href={`/tags/${tagSlug(tag)}/`}
                      class="inline-flex items-center rounded-full bg-surface-2 px-2.5 py-0.5 text-xs text-sub transition-colors hover:bg-accent-100 hover:text-accent-700"
                    >
                      # {tag}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <Prose>
          <Content />
        </Prose>
      </div>

      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="上一篇下一篇">
        {
          older ? (
            <a
              href={`/posts/${older.id}/`}
              class="group rounded-3xl border border-line bg-surface p-4 transition-all hover:-translate-y-0.5 hover:shadow-card"
            >
              <span class="flex items-center gap-1 text-xs text-sub">
                <Icon name="material-symbols:keyboard-arrow-left" class="size-4" />
                上一篇
              </span>
              <span class="mt-1 line-clamp-1 block text-sm text-ink group-hover:text-wash-pink-deep">
                {older.data.title}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a
              href={`/posts/${newer.id}/`}
              class="group rounded-3xl border border-line bg-surface p-4 text-right transition-all hover:-translate-y-0.5 hover:shadow-card"
            >
              <span class="flex items-center justify-end gap-1 text-xs text-sub">
                下一篇
                <Icon name="material-symbols:keyboard-arrow-right" class="size-4" />
              </span>
              <span class="mt-1 line-clamp-1 block text-sm text-ink group-hover:text-wash-pink-deep">
                {newer.data.title}
              </span>
            </a>
          )
        }
      </nav>

      <Giscus />
    </article>

    <!-- TOC 悬浮在文章容器外侧（≥1536px 视口），不挤占正文宽度 -->
    <div class="hidden 2xl:block absolute top-0 bottom-0 left-full ml-10 w-56">
      <div class="sticky top-24">
        <Toc headings={headings} />
      </div>
    </div>
  </div>
</BaseLayout>
