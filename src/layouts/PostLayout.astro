---
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import Toc from '../components/Toc.astro';
import Giscus from '../components/Giscus.astro';
import ImasAlbum from '../components/skins/ImasAlbum.astro';
import { categorySlug, tagSlug, SITE } from '../site.config';
import { formatDate, formatCount, readingTime, wordcount } from '../lib/utils';

interface PostRef {
  id: string;
  data: { title: string };
}

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      date: Date;
      updated?: Date;
      tags: string[];
      categories: string[];
      description?: string;
      skin?: 'imas-album';
    };
  };
  Content: (...args: any[]) => any;
  headings: { depth: number; slug: string; text: string }[];
  /** 按日期排序后的相邻文章（newer 较新，older 较旧） */
  newer?: PostRef | null;
  older?: PostRef | null;
}

const { post, Content, headings, newer = null, older = null } = Astro.props;
const { data } = post;
const words = wordcount(post.body ?? '');
const minutes = readingTime(post.body ?? '');
---

<BaseLayout
  title={`${data.title} · ${SITE.title}`}
  description={data.description}
  ogType="article"
  pathname={`/posts/${post.id}/`}
  mainClass="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-10"
>
  {
    data.skin === 'imas-album' && <ImasAlbum />
  }

  <div class="relative">
    <article class="min-w-0">
      <header class="mb-8">
        {
          data.categories.length > 0 && (
            <nav class="mb-3 flex flex-wrap gap-1.5" aria-label="分类">
              {data.categories.map((category) => (
                <a
                  href={`/categories/${categorySlug(category)}/`}
                  class="inline-flex items-center rounded-full bg-accent-100 px-2.5 py-0.5 text-xs font-medium text-accent-700 transition-colors hover:bg-accent-200 dark:bg-accent-900/50 dark:text-accent-300 dark:hover:bg-accent-900"
                >
                  {category}
                </a>
              ))}
            </nav>
          )
        }
        <h1 class="text-2xl leading-tight font-bold tracking-tight text-neutral-900 sm:text-3xl dark:text-neutral-50">
          {data.title}
        </h1>

        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-neutral-500 dark:text-neutral-400">
          <span class="inline-flex items-center gap-1">
            <Icon name="material-symbols:calendar-month" class="size-3.5" />
            <time datetime={data.date.toISOString()}>发布于 {formatDate(data.date)}</time>
          </span>
          {
            data.updated && data.updated.getTime() !== data.date.getTime() && (
              <span class="inline-flex items-center gap-1">
                <Icon name="material-symbols:article" class="size-3.5" />
                <time datetime={data.updated.toISOString()}>更新于 {formatDate(data.updated)}</time>
              </span>
            )
          }
          <span class="inline-flex items-center gap-1">
            <Icon name="material-symbols:schedule" class="size-3.5" />
            约 {minutes} 分钟 · {formatCount(words)} 字
          </span>
        </div>

        {
          data.tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="标签">
              {data.tags.map((tag) => (
                <li>
                  <a
                    href={`/tags/${tagSlug(tag)}/`}
                    class="inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs text-neutral-600 transition-colors hover:bg-accent-100 hover:text-accent-600 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-accent-900/50 dark:hover:text-accent-300"
                  >
                    # {tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      <Prose>
        <Content />
      </Prose>

      <nav class="mt-10 grid gap-3 sm:grid-cols-2" aria-label="上一篇下一篇">
        {
          older ? (
            <a
              href={`/posts/${older.id}/`}
              class="group rounded-xl border border-neutral-200/70 bg-white p-4 transition-shadow hover:shadow-card dark:border-neutral-800 dark:bg-neutral-800/40"
            >
              <span class="flex items-center gap-1 text-xs text-neutral-500 dark:text-neutral-400">
                <Icon name="material-symbols:keyboard-arrow-left" class="size-4" />
                上一篇
              </span>
              <span class="mt-1 line-clamp-1 block text-sm font-medium text-neutral-800 group-hover:text-accent-600 dark:text-neutral-200 dark:group-hover:text-accent-400">
                {older.data.title}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <a
              href={`/posts/${newer.id}/`}
              class="group rounded-xl border border-neutral-200/70 bg-white p-4 text-right transition-shadow hover:shadow-card dark:border-neutral-800 dark:bg-neutral-800/40"
            >
              <span class="flex items-center justify-end gap-1 text-xs text-neutral-500 dark:text-neutral-400">
                下一篇
                <Icon name="material-symbols:keyboard-arrow-right" class="size-4" />
              </span>
              <span class="mt-1 line-clamp-1 block text-sm font-medium text-neutral-800 group-hover:text-accent-600 dark:text-neutral-200 dark:group-hover:text-accent-400">
                {newer.data.title}
              </span>
            </a>
          )
        }
      </nav>

      <Giscus />
    </article>

    <!-- TOC 悬浮在文章容器外侧（≥1536px 视口），不挤占正文宽度 -->
    <div class="hidden 2xl:block absolute top-0 bottom-0 left-full ml-10 w-56">
      <div class="sticky top-24">
        <Toc headings={headings} />
      </div>
    </div>
  </div>
</BaseLayout>
