---
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import Toc from '../components/Toc.astro';
import Giscus from '../components/Giscus.astro';
import BackToTop from '../components/BackToTop.astro';
import ImasAlbum from '../components/skins/ImasAlbum.astro';
import ArticleLicense from '../components/ArticleLicense.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Card from '../components/primitives/Card.astro';
import TagChip from '../components/primitives/TagChip.astro';
import Container from '../components/primitives/Container.astro';
import { categoryFillClass, categorySlug, tagSlug, SITE } from '../site.config';
import { formatDate, formatCount, readingTime, wordcount } from '../lib/utils';
import type { PostLicense } from '../lib/post-frontmatter';

interface PostRef {
  id: string;
  data: { title: string };
}

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      date: Date;
      updated?: Date;
      tags: string[];
      categories: string[];
      description?: string;
      keywords?: string[];
      skin?: 'imas-album';
      license?: PostLicense;
      toc?: boolean;
    };
  };
  Content: (...args: any[]) => any;
  headings: { depth: number; slug: string; text: string }[];
  /** 按日期排序后的相邻文章（newer 较新，older 较旧） */
  newer?: PostRef | null;
  older?: PostRef | null;
}

const { post, Content, headings, newer = null, older = null } = Astro.props;
const { data } = post;
const words = wordcount(post.body ?? '');
const minutes = readingTime(post.body ?? '');
const category = data.categories[0];
const showToc = data.toc !== false && !data.categories.includes('小游戏');
---

<BaseLayout
  title={`${data.title} · ${SITE.title}`}
  description={data.description}
  keywords={data.keywords}
  ogType="article"
  pathname={`/posts/${post.id}/`}
  mainClass="py-8 sm:py-10"
  readingProgress
>
  {
    data.skin === 'imas-album' && <ImasAlbum />
  }
  <CodeBlock />

  <!-- gap-8 = 32px：1024 宽时容器可用 1009（视口减 15px scrollbar-gutter，见 global.css 的
       scrollbar-gutter: stable），减 48 内边距与 TOC 224 后，文章栏 705、面板内容盒 625 ——
       正文列 ≥620。用 gap-10（40px）只剩 617，会把 40em 的正文压到 620 以下。 -->
  <Container width="wide" class="flex justify-center gap-8">
    <article class="min-w-0 max-w-5xl flex-1">
      <!-- 文章面板（D3）：无描边、无圆角、无阴影 —— 用 --surface 比页面 --bg 高一档色阶
           划出阅读区，边界不再靠 1px 线条。 -->
      <div class="post-panel bg-surface p-5 sm:p-8 lg:p-10">
        <header class="mb-9">
          <!-- 分类 chip 从 h1 上方移到元信息行（屋规：标题上方不放小标签）。放在 h1 之后
               既保住了分类入口，也不再被探针判成 eyebrow。 -->
          <h1 class="post-title text-ink [text-wrap:balance]">
            {data.title}
          </h1>

          <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-note text-sub">
            {
              category && (
                <a
                  href={`/categories/${categorySlug(category)}/`}
                  class:list={[
                    'inline-flex items-center rounded-full px-2.5 py-0.5 text-note text-cat-on transition-opacity hover:opacity-85',
                    categoryFillClass(category),
                  ]}
                >
                  {category}
                </a>
              )
            }
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:calendar-month" class="size-3.5" aria-hidden="true" />
              <time datetime={data.date.toISOString()}>发布于 {formatDate(data.date)}</time>
            </span>
            {
              data.updated && data.updated.getTime() !== data.date.getTime() && (
                <span class="inline-flex items-center gap-1">
                  <Icon name="material-symbols:article" class="size-3.5" aria-hidden="true" />
                  <time datetime={data.updated.toISOString()}>更新于 {formatDate(data.updated)}</time>
                </span>
              )
            }
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:schedule" class="size-3.5" aria-hidden="true" />
              约 {minutes} 分钟 · {formatCount(words)} 字
            </span>
          </div>

          {
            data.tags.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="标签">
                {data.tags.map((tag) => (
                  <li>
                    <TagChip href={`/tags/${tagSlug(tag)}/`} label={`# ${tag}`} />
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <Prose>
          <Content />
        </Prose>

        {data.license === 'original' && (
          <ArticleLicense title={data.title} id={post.id} class="post-license" />
        )}
      </div>

      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="上一篇下一篇">
        {
          older ? (
            <Card as="a" href={`/posts/${older.id}/`} class="group p-4">
              <span class="flex items-center gap-1 text-note text-sub">
                <Icon name="material-symbols:keyboard-arrow-left" class="size-4" aria-hidden="true" />
                上一篇
              </span>
              <span class="mt-1 line-clamp-1 block text-base text-ink group-hover:text-wash-pink-deep">
                {older.data.title}
              </span>
            </Card>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <Card as="a" href={`/posts/${newer.id}/`} class="group p-4 text-right">
              <span class="flex items-center justify-end gap-1 text-note text-sub">
                下一篇
                <Icon name="material-symbols:keyboard-arrow-right" class="size-4" aria-hidden="true" />
              </span>
              <span class="mt-1 line-clamp-1 block text-base text-ink group-hover:text-wash-pink-deep">
                {newer.data.title}
              </span>
            </Card>
          )
        }
      </nav>

      <Giscus />
    </article>

    <!-- TOC：≥lg 是吸顶侧栏，<lg 是底部悬浮 pill —— 两种形态都在 Toc 内部（同一份树数据）。
         aside 用 display:contents 把布局盒子摘掉：窄屏时它不参与 flex 布局、不吃 gap 宽度，
         宽屏时恢复成 w-56 的一栏。 -->
    {
      showToc && (
        <aside class="contents lg:block lg:w-56 lg:shrink-0">
          <Toc headings={headings} />
        </aside>
      )
    }
  </Container>
  <BackToTop />
</BaseLayout>

<style>
  /* 文章标题是五档字号（D2）的唯一例外，原因写在前面：display 档是给 6–10 字的页面标题
     准备的，31 字的中文长标题在 60px 下断成 3 行反而更难读。长标题的换行约束优先于
     刻度整齐：390 宽 28px，1440 宽封顶 36.8px，大约每行 17–20 个汉字。
     C 方向：标题与正文 h2 用系统衬线栈（思源宋体优先、SimSun 回退），与首页 hero 的
     明朝体呼应；不加载 webfont。 */
  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 2.5vw, 2.3rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  /* 正文列（--measure = 40 × --prose-size = 680px @17px 正文档）在面板内居中：标题、元信息、
     正文共用同一条列。面板取 52rem = 832px，lg:p-10 两侧各 40 → 内容盒 752，文本列 680 居中后
     两侧各留 36px。只居中正文会让标题与元信息的左边缘错开 36px，像排版事故。
     Chrome 实测（preview，scrollbar-gutter 计入；正文/标题左右边完全重合）：
       1920  容器 1280、文章栏 976、面板 832（两侧各 72）、文本列 680（x 484.5–1164.5）
       1440  容器 1152、文章栏 848、面板 832（两侧各 8）、文本列 680（x 244.5–924.5）
       1024  容器 1009、文章栏 705、面板 705（铺满）、内容盒 625（x 64–689，自适应收窄）
     文章栏比设计稿的 888 少 40：容器 max-width 1152 是 border-box，含 24×2 内边距，再减
     gap 32 与 TOC 224。面板两侧因此只有 8px，不是设计稿按 888 算出的 28px。
     `.prose` 的元素由 Prose.astro 渲染，故用 :global 把它排除出本组件的 scope 属性。 */
  .post-panel > header,
  .post-panel > :global(.prose),
  .post-panel > :global(.post-license) {
    max-width: var(--measure);
    margin-inline: auto;
  }

  .post-panel {
    max-width: 52rem;
    margin-inline: auto;
  }
</style>
