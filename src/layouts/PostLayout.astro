---
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import Toc from '../components/Toc.astro';
import Giscus from '../components/Giscus.astro';
import ImasAlbum from '../components/skins/ImasAlbum.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Card from '../components/primitives/Card.astro';
import TagChip from '../components/primitives/TagChip.astro';
import Container from '../components/primitives/Container.astro';
import { categoryFillClass, categorySlug, tagSlug, SITE } from '../site.config';
import { formatDate, formatCount, readingTime, wordcount } from '../lib/utils';

interface PostRef {
  id: string;
  data: { title: string };
}

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      date: Date;
      updated?: Date;
      tags: string[];
      categories: string[];
      description?: string;
      skin?: 'imas-album';
    };
  };
  Content: (...args: any[]) => any;
  headings: { depth: number; slug: string; text: string }[];
  /** 按日期排序后的相邻文章（newer 较新，older 较旧） */
  newer?: PostRef | null;
  older?: PostRef | null;
}

const { post, Content, headings, newer = null, older = null } = Astro.props;
const { data } = post;
const words = wordcount(post.body ?? '');
const minutes = readingTime(post.body ?? '');
const category = data.categories[0];
---

<BaseLayout
  title={`${data.title} · ${SITE.title}`}
  description={data.description}
  ogType="article"
  pathname={`/posts/${post.id}/`}
  mainClass="py-8 sm:py-10"
>
  {
    data.skin === 'imas-album' && <ImasAlbum />
  }
  <CodeBlock />

  <Container width="wide" class="flex justify-center gap-10">
    <article class="min-w-0 max-w-4xl flex-1">
      <!-- 文章面板：Apple 式大标题 + 舒适栏宽 -->
      <div class="rounded-3xl border border-line bg-surface p-6 shadow-card sm:p-10 lg:p-12">
        <header class="mb-9">
          {
            category && (
              <a
                href={`/categories/${categorySlug(category)}/`}
                class:list={[
                  'inline-flex items-center rounded-full px-3.5 py-1 text-xs text-cat-on transition-opacity hover:opacity-85',
                  categoryFillClass(category),
                ]}
              >
                {category}
              </a>
            )
          }
          <h1 class="mt-4 text-2xl leading-snug tracking-[0.04em] text-ink sm:text-[2rem]">
            {data.title}
          </h1>

          <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-sub">
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:calendar-month" class="size-3.5" />
              <time datetime={data.date.toISOString()}>发布于 {formatDate(data.date)}</time>
            </span>
            {
              data.updated && data.updated.getTime() !== data.date.getTime() && (
                <span class="inline-flex items-center gap-1">
                  <Icon name="material-symbols:article" class="size-3.5" />
                  <time datetime={data.updated.toISOString()}>更新于 {formatDate(data.updated)}</time>
                </span>
              )
            }
            <span class="inline-flex items-center gap-1">
              <Icon name="material-symbols:schedule" class="size-3.5" />
              约 {minutes} 分钟 · {formatCount(words)} 字
            </span>
          </div>

          {
            data.tags.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="标签">
                {data.tags.map((tag) => (
                  <li>
                    <TagChip href={`/tags/${tagSlug(tag)}/`} label={`# ${tag}`} />
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <Prose>
          <Content />
        </Prose>
      </div>

      <nav class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="上一篇下一篇">
        {
          older ? (
            <Card as="a" href={`/posts/${older.id}/`} class="group p-4">
              <span class="flex items-center gap-1 text-xs text-sub">
                <Icon name="material-symbols:keyboard-arrow-left" class="size-4" />
                上一篇
              </span>
              <span class="mt-1 line-clamp-1 block text-sm text-ink group-hover:text-wash-pink-deep">
                {older.data.title}
              </span>
            </Card>
          ) : (
            <span />
          )
        }
        {
          newer && (
            <Card as="a" href={`/posts/${newer.id}/`} class="group p-4 text-right">
              <span class="flex items-center justify-end gap-1 text-xs text-sub">
                下一篇
                <Icon name="material-symbols:keyboard-arrow-right" class="size-4" />
              </span>
              <span class="mt-1 line-clamp-1 block text-sm text-ink group-hover:text-wash-pink-deep">
                {newer.data.title}
              </span>
            </Card>
          )
        }
      </nav>

      <Giscus />
    </article>

    <!-- TOC：≥lg 双栏（原先只从 xl 起，1024–1279px 就出现「宽容器 + 无侧栏」的横向浪费）；
         吸顶但容器自身可滚轮浏览长目录，随文章容器结束而结束 -->
    <aside class="hidden w-56 shrink-0 lg:block">
      <div class="toc-scroll sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto overscroll-contain">
        <Toc headings={headings} />
      </div>
    </aside>
  </Container>
</BaseLayout>
