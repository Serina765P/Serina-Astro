---
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import Giscus from '../components/Giscus.astro';
import { SITE } from '../site.config';

interface Props {
  title: string;
  description?: string;
  showComments?: boolean;
}

const { title, description, showComments = false } = Astro.props;
---

<BaseLayout title={`${title} · ${SITE.title}`} description={description} pathname={Astro.url.pathname}>
  <div class="mx-auto max-w-3xl">
    <header class="mb-8">
      <h1 class="text-3xl tracking-[0.15em] text-ink">{title}</h1>
    </header>

    <Prose>
      <slot />
    </Prose>

    {showComments && <Giscus />}
  </div>
</BaseLayout>
