---
import BaseLayout from './BaseLayout.astro';
import Prose from '../components/Prose.astro';
import Giscus from '../components/Giscus.astro';
import PageHeader from '../components/primitives/PageHeader.astro';
import Container from '../components/primitives/Container.astro';
import { SITE } from '../site.config';

interface Props {
  title: string;
  description?: string;
  showComments?: boolean;
}

const { title, description, showComments = false } = Astro.props;
---

<BaseLayout title={`${title} · ${SITE.title}`} description={description} pathname={Astro.url.pathname}>
  <Container width="content">
    <PageHeader title={title} />

    <Prose>
      <slot />
    </Prose>

    {showComments && <Giscus />}
  </Container>
</BaseLayout>
