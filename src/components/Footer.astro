---
import { SIDEBAR, SITE } from '../site.config';

const year = new Date().getFullYear();
const range = year > SITE.since ? `${SITE.since} - ${year}` : String(SITE.since);
---

<footer class="border-t border-neutral-200/70 py-8 dark:border-neutral-800">
  <div class="mx-auto max-w-5xl px-4 text-center text-sm text-neutral-500 sm:px-6 dark:text-neutral-400">
    <p>
      © {range}
      <a href="/" class="text-accent-600 transition-colors hover:text-accent-500 dark:text-accent-400 dark:hover:text-accent-300">{SITE.author}</a>
      · Powered by
      <a href="https://astro.build" target="_blank" rel="noopener" class="transition-colors hover:text-accent-500 dark:hover:text-accent-300">Astro</a>
    </p>
    <p class="mt-1 text-xs text-neutral-400 dark:text-neutral-500">
      {SITE.description}
    </p>
  </div>
</footer>
