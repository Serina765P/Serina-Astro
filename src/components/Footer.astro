---
import { SITE } from '../site.config';
import Container from './primitives/Container.astro';
import { yearInShanghai } from '../lib/utils';

const year = yearInShanghai(new Date());
const range = year > SITE.since ? `${SITE.since} - ${year}` : String(SITE.since);
---

<footer class="pb-10 pt-4">
  <Container width="standard" class="text-center text-base text-sub">
    <p>
      © {range}
      {" "}
      <a href="/" class="text-wash-pink-deep transition-colors hover:text-wash-rose-deep">{SITE.author}</a>
      {" "}·{" "}
      <a
        href="https://www.serinap.top/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-brand-strong transition-colors hover:text-brand"
      >个人主页</a>
      {" "}· Powered by{" "}
      <a href="https://astro.build" target="_blank" rel="noopener" class="transition-colors hover:text-wash-pink-deep">Astro</a>
    </p>
  </Container>
</footer>
