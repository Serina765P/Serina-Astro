---
import { Icon } from 'astro-icon/components';
import { NAV, SITE } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/') return current === '/';
  return current === target || current.startsWith(`${target}/`);
};
---

<header class="sticky top-0 z-40 border-b border-line bg-nav backdrop-blur-md backdrop-saturate-150">
  <div class="flex h-16 w-full items-center justify-between gap-4 px-4 sm:px-6 lg:px-10">
    <a href="/" class="flex min-w-0 items-center gap-2.5 rounded-full py-1 pr-2">
      <img src="/images/fav.webp" alt="" class="size-8 shrink-0 rounded-full shadow-card" />
      <span class="truncate tracking-[0.12em] text-ink">{SITE.title}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm transition-colors',
              isActive(item.href)
                ? 'bg-surface font-medium text-ink shadow-card'
                : 'text-sub hover:bg-surface-2 hover:text-ink',
            ]}
          >
            <Icon name={`material-symbols:${item.icon}`} class="size-4" />
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <a
        href="/search/"
        aria-label="搜索"
        class="grid size-9 place-items-center rounded-full text-sub transition-colors hover:bg-surface-2 hover:text-wash-pink-deep"
      >
        <Icon name="material-symbols:search" class="size-5" />
      </a>
      <ThemeToggle />
      <button
        id="mobile-menu-button"
        type="button"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-9 place-items-center rounded-full text-sub transition-colors hover:bg-surface-2 hover:text-wash-pink-deep lg:hidden"
      >
        <Icon name="material-symbols:menu" class="menu-open-icon size-5" />
        <Icon name="material-symbols:close" class="menu-close-icon hidden size-5" />
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    hidden
    class="border-t border-line px-4 pb-4 pt-2 lg:hidden"
    aria-label="移动端导航"
  >
    <ul class="grid grid-cols-2 gap-1">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'flex items-center gap-2 rounded-2xl px-3 py-2 text-sm transition-colors',
                isActive(item.href)
                  ? 'bg-surface font-medium text-ink shadow-card'
                  : 'text-sub hover:bg-surface-2',
              ]}
            >
              <Icon name={`material-symbols:${item.icon}`} class="size-4" />
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // 事件委托绑定在 document 上：ClientRouter 换页后依然生效
  function setMenuOpen(open: boolean) {
    const button = document.querySelector<HTMLButtonElement>('#mobile-menu-button');
    const menu = document.querySelector<HTMLElement>('#mobile-menu');
    if (!button || !menu) return;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
    menu.hidden = !open;
    button.querySelector('.menu-open-icon')?.classList.toggle('hidden', open);
    button.querySelector('.menu-close-icon')?.classList.toggle('hidden', !open);
    if (open) button.dataset.menuOpen = 'true';
    else delete button.dataset.menuOpen;
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest<HTMLButtonElement>('#mobile-menu-button');
    if (button) {
      setMenuOpen(button.getAttribute('aria-expanded') !== 'true');
      return;
    }
    // 菜单展开时：点击菜单外任意处关闭
    const menu = document.querySelector<HTMLElement>('#mobile-menu');
    if (menu && !menu.hidden && !target?.closest('#mobile-menu')) setMenuOpen(false);
  });

  // Esc 关闭并把焦点还给按钮
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const button = document.querySelector<HTMLButtonElement>('#mobile-menu-button');
    if (button?.dataset.menuOpen === 'true') {
      setMenuOpen(false);
      button.focus();
    }
  });
</script>
