---
import { Icon } from 'astro-icon/components';
import { NAV, SITE } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/') return current === '/';
  return current === target || current.startsWith(`${target}/`);
};
---

<header class="sticky top-0 z-40 border-b border-line bg-nav backdrop-blur-md backdrop-saturate-150">
  <div class="flex h-16 w-full items-center justify-between gap-4 px-4 sm:px-6 lg:px-10">
    <a href="/" class="flex min-w-0 items-center gap-2.5 rounded-full py-1 pr-2">
      <img src="/images/fav.webp" alt="" class="size-8 shrink-0 rounded-full shadow-card" />
      <span class="truncate tracking-[0.12em] text-ink">{SITE.title}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm transition-colors',
              isActive(item.href)
                ? 'bg-surface font-medium text-ink shadow-card'
                : 'text-sub hover:bg-surface-2 hover:text-ink',
            ]}
          >
            <Icon name={`material-symbols:${item.icon}`} class="size-4" />
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <a
        href="/search/"
        aria-label="搜索"
        class="grid size-9 place-items-center rounded-full text-sub transition-colors hover:bg-surface-2 hover:text-wash-pink-deep"
      >
        <Icon name="material-symbols:search" class="size-5" />
      </a>
      <ThemeToggle />

      <!-- 移动端菜单 CSS-only：展开态由 <details open> 承载（无 JS 可展开/跳转/收起），
           脚本只做增强。面板用实心 --surface（P2-14），并绝对定位到 header 下沿。 -->
      <details class="mobile-menu group lg:hidden" data-mobile-menu>
        <summary
          aria-label="菜单"
          class="grid size-9 cursor-pointer list-none place-items-center rounded-full text-sub transition-colors hover:bg-surface-2 hover:text-wash-pink-deep [&::-webkit-details-marker]:hidden"
        >
          <Icon name="material-symbols:menu" class="menu-open-icon size-5 group-open:hidden" />
          <Icon
            name="material-symbols:close"
            class="menu-close-icon hidden size-5 group-open:block"
          />
        </summary>

        <!-- 面板：原先继承 header 的半透明 --nav-bg + 模糊底，展开时正文会透上来（P2-14） -->
        <nav
          id="mobile-menu"
          aria-label="移动端导航"
          class="absolute inset-x-0 top-full border-t border-b border-line bg-surface px-4 pt-2 pb-4"
        >
          <ul class="grid grid-cols-2 gap-1">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'flex items-center gap-2 rounded-2xl px-3 py-2 text-sm transition-colors',
                      isActive(item.href)
                        ? 'bg-surface-2 font-medium text-ink'
                        : 'text-sub hover:bg-surface-2',
                    ]}
                  >
                    <Icon name={`material-symbols:${item.icon}`} class="size-4" />
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // 只做增强，绝不代管 summary 的点击（否则与 <details> 原生切换打架、一次点击切换两次）。
  // 事件委托绑在 document 上：ClientRouter 换页后依然生效。
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('details[data-mobile-menu]')) {
      if (menu.open && !target?.closest('details[data-mobile-menu]')) menu.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const menu = document.querySelector<HTMLDetailsElement>('details[data-mobile-menu][open]');
    if (!menu) return;
    menu.open = false;
    menu.querySelector('summary')?.focus();
  });
</script>
