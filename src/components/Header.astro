---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { HERO, NAV, SITE } from '../site.config';
import Container from './primitives/Container.astro';
import ThemeToggle from './ThemeToggle.astro';

// trailingSlash: 'always' 后 pathname 恒带尾斜杠（/archives/），NAV 的 href 也全部以 / 结尾，
// 无需再手工去尾斜杠比对
const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<!-- 去 1px 下边框（D3）：吸顶头用不透明 --nav-bg 与正文分色阶，分隔不靠线条 -->
<header class="sticky top-0 z-nav bg-nav">
  <!-- 与页脚、首页/归档/分类/标签页共用同一个 Container 档位（standard = 64rem）：
       原先 w-full + lg:px-10 没有任何上限，宽屏下站点名/图标贴视口两端，而正文与页脚居中，
       视觉上等于两套网格；1024px 处内边距还比 Container 多 16px，左边缘也对不齐。
       文章页正文是 wide（72rem），比这层外壳宽 4rem，仍在同一中轴上，不影响阅读。 -->
  <Container width="standard" class="flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex min-w-0 items-center gap-2.5 rounded-full py-1 pr-2">
      <!-- S20：头像走 astro:assets，按显示尺寸缩放输出（32px 显示，2x 取 64）；
           fixed 布局只出 densities srcset；每页首屏元素，显式 eager -->
      <Image
        src={HERO.avatar}
        alt=""
        width={64}
        height={64}
        layout="fixed"
        loading="eager"
        class="size-8 shrink-0 rounded-full"
      />
      <span class="truncate tracking-[0.12em] text-ink">{SITE.title}</span>
    </a>

    <!-- 导航不收缩、链接不换行：16px（D2 的 base 档）比原来的 14px 宽，回退字体下
         8 条链接 + 图标在 1024 容器里会各自折成两行。图标内距与字距都收紧到最小，
         仍然放不下时再拆图标 —— 导航文字本身已经说清楚，图标只是重复。 -->
    <nav class="hidden shrink-0 items-center gap-1 lg:flex" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full px-3 py-1.5 text-base transition-colors',
              isActive(item.href)
                ? 'bg-surface font-medium text-ink'
                : 'text-sub hover:bg-surface-2 hover:text-ink',
            ]}
          >
            <Icon name={`material-symbols:${item.icon}`} class="size-4" aria-hidden="true" />
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <!-- 触摸目标：移动端 44px（size-11），≥sm 回到 36px 的紧凑密度 -->
      <a
        href="/search/"
        aria-label="搜索"
        class="grid size-11 place-items-center rounded-full text-sub transition-colors hover:bg-surface-2 hover:text-wash-pink-deep sm:size-9"
      >
        <Icon name="material-symbols:search" class="size-5" aria-hidden="true" />
      </a>
      <ThemeToggle />

      <!-- 移动端菜单 CSS-only：展开态由 <details open> 承载（无 JS 可展开/跳转/收起），
           脚本只做增强。面板用实心 --surface（P2-14），并绝对定位到 header 下沿。 -->
      <details class="mobile-menu group lg:hidden" data-mobile-menu>
        <summary
          aria-label="菜单"
          class="grid size-11 cursor-pointer list-none place-items-center rounded-full text-sub transition-colors hover:bg-surface-2 hover:text-wash-pink-deep sm:size-9 [&::-webkit-details-marker]:hidden"
        >
          <Icon name="material-symbols:menu" class="menu-open-icon size-5 group-open:hidden" aria-hidden="true" />
          <Icon
            name="material-symbols:close"
            class="menu-close-icon hidden size-5 group-open:block"
            aria-hidden="true"
          />
        </summary>

        <!-- 面板：走实心 --surface，与头部（不透明 --nav-bg）再差一档色阶，
             展开时既不透视正文、也能看出面板边界（P2-14 / D3 去玻璃）。 -->
        <nav
          id="mobile-menu"
          aria-label="移动端导航"
          class="absolute inset-x-0 top-full bg-surface px-4 pt-2 pb-4"
        >
          <ul class="grid grid-cols-2 gap-1">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'flex items-center gap-2 rounded-2xl px-3 py-2 text-base transition-colors',
                      isActive(item.href)
                        ? 'bg-surface-2 font-medium text-ink'
                        : 'text-sub hover:bg-surface-2',
                    ]}
                  >
                    <Icon name={`material-symbols:${item.icon}`} class="size-4" aria-hidden="true" />
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </Container>
</header>

<script>
  // 只做增强，绝不代管 summary 的点击（否则与 <details> 原生切换打架、一次点击切换两次）。
  // 事件委托绑在 document 上：ClientRouter 换页后依然生效。幂等标记挂在 <html> 上
  // （documentElement 不随换页被替换），脚本被重复执行时不会累积监听器。
  if (document.documentElement.dataset.menuBound !== 'true') {
    document.documentElement.dataset.menuBound = 'true';

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      for (const menu of document.querySelectorAll<HTMLDetailsElement>('details[data-mobile-menu]')) {
        if (menu.open && !target?.closest('details[data-mobile-menu]')) menu.open = false;
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const menu = document.querySelector<HTMLDetailsElement>('details[data-mobile-menu][open]');
      if (!menu) return;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  }
</script>
