---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'prose prose-neutral dark:prose-invert max-w-none',
    'prose-headings:scroll-mt-24',
    'prose-a:text-wash-pink-deep prose-a:decoration-wash-pink prose-a:underline-offset-4 prose-a:hover:text-wash-rose-deep',
    'prose-img:rounded-2xl prose-img:shadow-card',
    className,
  ]}
>
  <slot />
</div>
