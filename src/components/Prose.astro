---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'prose prose-neutral dark:prose-invert max-w-none',
    'prose-headings:scroll-mt-24 prose-headings:font-semibold prose-headings:tracking-tight',
    'prose-a:font-medium prose-a:text-accent-600 prose-a:decoration-accent-300 prose-a:underline-offset-4 hover:prose-a:text-accent-500 dark:prose-a:text-accent-400 dark:hover:prose-a:text-accent-300',
    'prose-img:rounded-xl prose-img:shadow-card',
    'prose-code:rounded prose-code:bg-neutral-100 prose-code:px-1 prose-code:py-0.5 prose-code:text-[0.875em] prose-code:font-normal prose-code:before:content-none prose-code:after:content-none dark:prose-code:bg-neutral-700/50',
    'prose-pre:rounded-xl prose-pre:bg-neutral-900 prose-pre:pt-4 prose-pre:pb-4 prose-pre:text-neutral-100 dark:prose-pre:bg-neutral-900',
    'prose-hr:border-neutral-200 dark:prose-hr:border-neutral-700',
    'prose-blockquote:border-l-accent-400 prose-blockquote:bg-accent-50/50 prose-blockquote:py-0.5 prose-blockquote:pr-4 prose-blockquote:rounded-r-lg prose-blockquote:not-italic dark:prose-blockquote:bg-accent-900/20 dark:prose-blockquote:border-l-accent-500',
    'prose-table:text-sm prose-th:bg-neutral-100 dark:prose-th:bg-neutral-800',
    className,
  ]}
>
  <slot />
</div>
