---
/**
 * 页面标题块基元（P1-1）：把各页「h1 + 可选 subtitle」的字面重复收敛到一处。
 * - h1：text-display + font-hero —— 页面级标题是全站最大的一档（D2），字体与首页 hero 共用
 *   朝华明朝体子集；不再按页面各写 text-3xl / text-[clamp()]；字距归零，标题靠字号与字重立住
 * - 不再提供 eyebrow：标题上方的小标签是探针判定的装饰性 kicker，信息应由标题或 subtitle 承担
 * - subtitle：标题下方的说明（如「共 N 篇文章」），它是说明句、要能读，故走 text-base 而不是 note 档
 * - class：覆盖 <header> 自身的布局类。默认 mb-10（2.5rem）—— 标题到内容的间距，不是分区间距；
 *   --space-section 只负责分节之间（1440 宽 88px），放到这里会在标题与它的列表之间撑出空洞。
 *   搜索页用 mb-6。宽度不归它管 —— 页面级宽度由 <Container> 提供（S12 起）
 */
interface Props {
  title: string;
  subtitle?: string;
  class?: string;
}

const { title, subtitle, class: className = 'mb-10' } = Astro.props;
---

<header class={className}>
  <h1 class="font-hero text-display tracking-normal text-ink">{title}</h1>
  {subtitle && <p class="mt-2 text-base text-sub">{subtitle}</p>}
</header>
