---
// 代码块超高自动折叠：超过阈值的长代码默认收起，可手动展开/收起。
// 渐进增强——脚本不运行时代码块保持完整展示。
---

<script>
  const FOLD_THRESHOLD = 480; // px，超过则折叠（收起高度见 global.css .code-fold.is-collapsed）

  function foldTallCode() {
    document.querySelectorAll<HTMLPreElement>('.prose .astro-code').forEach((pre) => {
      if (pre.dataset.foldBound) return;
      pre.dataset.foldBound = 'true';
      if (pre.scrollHeight <= FOLD_THRESHOLD) return;

      const wrap = document.createElement('div');
      wrap.className = 'code-fold is-collapsed';
      pre.before(wrap);

      const clip = document.createElement('div');
      clip.className = 'code-clip';
      clip.appendChild(pre);
      wrap.appendChild(clip);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-fold-btn';
      btn.setAttribute('aria-expanded', 'false');
      btn.textContent = '展开代码';
      btn.addEventListener('click', () => {
        const collapsed = wrap.classList.toggle('is-collapsed');
        btn.setAttribute('aria-expanded', String(!collapsed));
        btn.textContent = collapsed ? '展开代码' : '收起代码';
      });
      wrap.appendChild(btn);
    });
  }

  document.addEventListener('astro:page-load', foldTallCode);
</script>
