---
// 文章目录。两种形态由 [data-toc-form] 区分，共用同一份构建期算好的树：
//   sidebar —— ≥lg 的侧栏，自身就是吸顶 + 滚动容器；
//   card    —— <lg 的底部悬浮 pill，点开向上展开卡片，pill 上常驻显示当前节名。
// 卡片形态虽然是不占布局的 fixed 元素，但仍然渲染在调用方给的容器里 —— 由 <aside>
// 用 display: contents 把它的布局盒子摘掉，这样两种形态可以同处一个组件。
import { Icon } from 'astro-icon/components';
import TocTree from './TocTree.astro';
import { buildTocTree, shouldCollapseToc, type TocHeading } from '../lib/toc';

interface Props {
  headings: TocHeading[];
}

// Astro.props 在这里是 Record<string, any>，断言一次即可拿到 Props 的形状
// （不写断言的话，interface Props 会被报成声明后未使用）
const { headings } = Astro.props as Props;
// 构树与折叠判定都落在构建期，客户端拿到的就是最终结构（不需要在浏览器里拼 HTML）
const tree = buildTocTree(headings);
const collapsible = shouldCollapseToc(tree);
// 空字符串 = 属性存在；undefined = 属性不渲染
const collapseAttr = collapsible ? '' : undefined;
---

{
  tree.length > 0 && (
    <>
      <nav
        class="toc toc-scroll hidden lg:flex"
        data-toc-root
        data-toc-form="sidebar"
        data-toc-collapse={collapseAttr}
        aria-label="本文目录"
      >
        <p class="toc-title">本文目录</p>
        <div class="toc-panel" data-toc-panel>
          <div class="toc-contents" data-toc-contents>
            <div class="toc-indicator" data-toc-indicator aria-hidden="true" />
            <TocTree nodes={tree} collapsible={collapsible} idPrefix="toc-side" />
          </div>
        </div>
      </nav>

      <div
        class="toc toc-card lg:hidden"
        data-toc-root
        data-toc-form="card"
        data-toc-collapse={collapseAttr}
      >
        <details class="toc-details" data-toc-details>
          <summary class="toc-summary">
            <Icon
              name="material-symbols:segment"
              class="toc-summary-icon"
              aria-hidden="true"
            />
            <span class="toc-current" data-toc-current>本文目录</span>
            <Icon
              name="material-symbols:keyboard-arrow-up"
              class="toc-summary-chevron"
              aria-hidden="true"
            />
          </summary>
        </details>
        <nav class="toc-panel toc-scroll" data-toc-panel aria-label="本文目录">
          <div class="toc-contents" data-toc-contents>
            <TocTree nodes={tree} collapsible={collapsible} idPrefix="toc-card" />
          </div>
        </nav>
      </div>
    </>
  )
}

<style>
  /* 机制移植自 mediawiki-skins-Citizen：一条竖线 + 一条会滑动、会伸缩的高亮段。
     与旧实现（逐项把左边框换成粉色、只激活一根标题）的区别在于位置感 ——
     高亮是一个可以看见移动的物体，而不是一串互相独立的状态。 */
  .toc {
    --toc-line: 2px;
  }

  .toc-title {
    margin: 0 0 0.7rem;
    padding-left: 0.75rem;
    color: var(--sub);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
  }

  /* ── 侧栏形态 ──
     宽度取现有占位的 1.4 倍（14rem → 19.6rem），向右扩。aside 那边仍然只吃 14rem 的
     布局宽度（PostLayout 的 lg:w-56），多出来的这部分溢到容器右侧的页面留白里 ——
     正文栏的宽度和位置一个像素都不动。
     用 max() 兜住窄屏：视口 ≤72rem 时容器已占满、没有留白可借，就退回原宽度。
     50vw - 23rem 的来历：容器最宽 72rem 且居中，一侧留白 = 50vw - 36rem；再减掉
     1.5rem 内边距与 1rem 安全余量，加上原本的 14rem 占位。 */
  .toc[data-toc-form='sidebar'] {
    --toc-sidebar-width: min(19.6rem, max(14rem, calc(50vw - 23rem)));
    position: sticky;
    top: 6rem;
    width: var(--toc-sidebar-width);
    flex-direction: column;
    max-height: calc(100vh - 7rem);
  }

  .toc[data-toc-form='sidebar'] .toc-panel {
    /* flex 子项要能收缩，否则内容会把它撑开、滚动条永远不出现 */
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* ── 卡片形态 ── */
  .toc[data-toc-form='card'] {
    position: fixed;
    bottom: 1.25rem;
    left: 1rem;
    z-index: var(--z-sticky-head);
  }

  .toc-summary {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    max-width: calc(100vw - 2rem);
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 9999px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: var(--body);
    font-size: 0.875rem;
    line-height: 1.2;
    cursor: pointer;
    list-style: none;
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-summary-icon,
  .toc-summary-chevron {
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--sub);
    transition: transform 200ms ease;
  }

  /* 当前节名会随滚动变长变短，截断而不是把 pill 撑破 */
  .toc-current {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .toc-details[open] .toc-summary-chevron {
    transform: rotate(180deg);
  }

  /* 卡片向上展开：pill 钉在底部不动，面板从它上面长出来 */
  .toc[data-toc-form='card'] .toc-panel {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    display: none;
    width: min(21rem, calc(100vw - 2rem));
    max-height: min(60vh, 26rem);
    padding: 0.9rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: var(--shadow-card-hover);
  }

  .toc[data-toc-form='card'] .toc-details[open] ~ .toc-panel {
    display: block;
  }

  /* ── 指示条 ── */
  .toc-contents {
    position: relative;
    border-left: var(--toc-line) solid var(--line);
  }

  .toc-indicator {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: var(--toc-line);
    height: var(--toc-unit-height, 2rem);
    /* 压在竖线上：absolute 的 left 从 padding box 起算，往左挪一个线宽就盖住边框 */
    margin-left: calc(var(--toc-line) * -1);
    border-radius: var(--toc-line);
    background: var(--wash-pink-deep);
    /* translateY + scaleY 合成到 GPU：既不重排，过渡也不掉帧 */
    transform: translateY(var(--toc-indicator-top, 0)) scaleY(var(--toc-indicator-scale, 0));
    transform-origin: top center;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script>
  // 滚动联动（激活区间 / 指示条 / 容器跟随 / 折叠展开）都在这个模块里，
  // 它自己挂 astro:page-load 与 astro:before-swap，换页后整体重建
  import '../scripts/toc';
</script>
