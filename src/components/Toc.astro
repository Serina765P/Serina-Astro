---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---

{
  toc.length > 0 && (
    <nav
      id="toc"
      aria-label="目录"
      class="hidden text-sm lg:block"
    >
      <p class="mb-3 tracking-[0.3em] text-sub">目录</p>
      <ul class="space-y-1.5 border-l border-line">
        {toc.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-toc-link
              class:list={[
                '-ml-px block border-l-2 border-transparent py-0.5 text-sub transition-colors hover:text-wash-pink-deep',
                heading.depth === 2 ? 'pl-3' : heading.depth === 3 ? 'pl-6 text-[0.9em]' : 'pl-9 text-[0.85em]',
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  @reference '../styles/global.css';

  [data-toc-link].toc-active {
    @apply border-wash-pink-deep font-medium text-ink;
  }
</style>

<script>
  let observer: IntersectionObserver | null = null;

  document.addEventListener('astro:before-swap', () => {
    observer?.disconnect();
    observer = null;
  });

  document.addEventListener('astro:page-load', () => {
    const toc = document.getElementById('toc');
    if (!toc) return;

    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[data-toc-link]')];
    const byId = new Map(links.map((a) => [a.getAttribute('href')!.slice(1), a]));

    observer?.disconnect();
    // 跨回调持续维护可见集：entries 只含状态变化的元素，每次重建会丢状态导致高亮乱跳
    const visible = new Set<string>();
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        if (visible.size === 0) return;
        // 单一高亮：取当前可见标题中最靠近视口顶部的一个（实时取位置，排序才准确）
        const top = [...visible]
          .map((id) => [id, document.getElementById(id)?.getBoundingClientRect().top ?? Infinity] as const)
          .sort((a, b) => a[1] - b[1])[0][0];
        for (const [id, link] of byId) link.classList.toggle('toc-active', id === top);
      },
      { rootMargin: '-80px 0px -70% 0px' },
    );
    for (const [id] of byId) {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    }
  });
</script>
