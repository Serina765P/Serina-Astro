<dialog id="lightbox" class="lightbox-dialog" closedby="any">
  <img src="" alt="" referrerpolicy="no-referrer" />
  <button
    type="button"
    aria-label="关闭预览"
    class="fixed top-4 right-4 grid size-10 cursor-pointer place-items-center rounded-full bg-scrim text-xl leading-none text-on-scrim transition-colors hover:bg-scrim-strong"
  >
    ×
  </button>
</dialog>

<script>
  // 点击正文/皮肤内的图片放大预览；委托绑定在 document 上，换页后依然生效。
  //
  // 关键点（S23）：模块脚本不会因 ClientRouter 换页而重跑，而换页会把 <dialog> 换成新节点 ——
  // 元素引用必须在每次 astro:page-load 重新查询，否则关闭按钮会绑在已脱离文档的旧节点上、
  // 换页后预览关不掉。这里用 isConnected 惰性失效 + page-load 预绑定两层保证。
  let dialog: HTMLDialogElement | null = null;
  let previewImg: HTMLImageElement | null = null;

  function refreshDialog() {
    if (dialog?.isConnected) return dialog;
    dialog = document.querySelector<HTMLDialogElement>('#lightbox');
    previewImg = dialog?.querySelector('img') ?? null;
    if (dialog && dialog.dataset.bound !== 'true') {
      dialog.dataset.bound = 'true';
      dialog.querySelector('button')?.addEventListener('click', () => dialog?.close());
    }
    return dialog;
  }

  function openLightbox(img: HTMLImageElement) {
    const el = refreshDialog();
    if (!el || !previewImg) return;
    previewImg.src = img.getAttribute('src') ?? '';
    previewImg.alt = img.alt;
    if (!el.open) el.showModal();
  }

  // 给正文/说说/专辑里的内容图补键盘入口（tabindex + button 语义）
  function enhanceImages() {
    document
      .querySelectorAll<HTMLImageElement>('.prose img, .album-grid img, .shuoshuo-images img')
      .forEach((img) => {
        if (img.closest('a') || img.closest('dialog')) return;
        if (img.getAttribute('role') === 'button') return;
        img.setAttribute('role', 'button');
        img.setAttribute('tabindex', '0');
        img.setAttribute('aria-label', `放大查看：${img.alt || '图片'}`);
      });
  }

  document.addEventListener('astro:page-load', () => {
    refreshDialog(); // 换页后立刻重绑关闭按钮，不等用户第一次点图
    enhanceImages();
  });

  document.addEventListener('click', (event) => {
    const el = refreshDialog();
    if (!el || !previewImg) return;
    // closedby="any" 仅 Chromium 134+ 支持：点 dialog 空白处关闭作为兜底
    if (event.target === el) {
      el.close();
      return;
    }
    const target = event.target as HTMLElement | null;
    const img = target?.closest('img');
    if (!img || !img.closest('.prose, .album-grid, .shuoshuo-images')) return;
    if (img.closest('a')) return;
    if (img.closest('dialog')) return;
    event.preventDefault();
    openLightbox(img);
  });

  // 键盘可达：Enter/Space 触发放大
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    const target = event.target;
    const img = target instanceof HTMLImageElement ? target : null;
    if (!img || img.getAttribute('role') !== 'button') return;
    if (!img.closest('.prose, .album-grid, .shuoshuo-images')) return;
    event.preventDefault();
    openLightbox(img);
  });
</script>
