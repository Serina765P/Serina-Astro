---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Card from './primitives/Card.astro';
import CategoryChip from './primitives/CategoryChip.astro';
import TagChip from './primitives/TagChip.astro';
import { tagSlug } from '../site.config';
import { formatDate, readingTime } from '../lib/utils';
import { getPostCover } from '../lib/post-covers';

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      date: Date;
      description?: string;
      tags: string[];
      categories: string[];
      cover?: string;
      pinned: boolean;
    };
  };
  /** 首页目录式列表使用扁平变体；分类页和标签页保留原卡片样式。 */
  variant?: 'default' | 'directory';
}

const { post, variant = 'default' } = Astro.props;
const isDirectory = variant === 'directory';
// 层级按上下文取：index.astro 的 directory 列表上层已有 <h2>（「最近写下的」），
// 卡片标题再写 <h2> 会与区块标题平级；标签/分类页的卡片直接跟在 h1 之后，仍是 h2。
const Heading = isDirectory ? 'h3' : 'h2';
const href = `/posts/${post.id}/`;
const minutes = post.body ? readingTime(post.body) : null;
const category = post.data.categories[0];
const cover = getPostCover(post.id, post.data.cover);
---

<Card
  as="article"
  lift={!isDirectory}
  data-tilt={isDirectory ? '' : undefined}
  class:list={[
    'group relative overflow-hidden',
    isDirectory ? (cover ? 'directory directory-with-cover' : 'directory') : '',
    !isDirectory && (cover ? 'p-0' : 'py-5 pr-5 pl-6 sm:py-6 sm:pr-6 sm:pl-7'),
  ]}
>
  {
    cover && (
      <Image
        src={cover}
        alt=""
        aria-hidden="true"
        width={cover.width}
        height={cover.height}
        layout="constrained"
        loading="lazy"
        class:list={['post-cover w-full object-cover', isDirectory ? 'h-full min-h-28' : 'h-44 sm:h-52']}
      />
    )
  }
  <div class:list={['relative', cover && !isDirectory ? 'p-5 sm:p-6 sm:pl-7' : '']}>
    <Heading class="text-lead">
      <a
        href={href}
        class:list={[
          'text-ink transition-colors after:absolute after:inset-0',
          isDirectory ? 'directory-title-link' : 'group-hover:text-wash-pink-deep',
        ]}
      >
        {isDirectory ? <span class="directory-title">{post.data.title}</span> : post.data.title}
        {
          isDirectory && (
            <Icon
              name="material-symbols:arrow-forward"
              class="directory-arrow size-4 shrink-0"
              aria-hidden="true"
            />
          )
        }
      </a>
    </Heading>

    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-note text-sub">
      {
        post.data.pinned && <span class="rounded-full bg-chip px-2.5 py-0.5 text-chip-fg">置顶</span>
      }
      {
        category && <CategoryChip name={category} link={false} />
      }
      <span class="inline-flex items-center gap-1">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </span>
      {
        minutes && (
          <span class="inline-flex items-center gap-1">约 {minutes} 分钟</span>
        )
      }
    </div>

    {
      post.data.description && (
        <p class="relative mt-2.5 line-clamp-2 text-base leading-normal text-body">{post.data.description}</p>
      )
    }

    {
      post.data.tags.length > 0 && (
        <ul class="relative mt-3 flex flex-wrap gap-1.5" aria-label="标签">
          {post.data.tags.slice(0, 4).map((tag) => (
            <li>
              <TagChip href={`/tags/${tagSlug(tag)}/`} label={`# ${tag}`} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Card>

<style>
  /* 目录式变体：卡片本身已无描边/圆角/阴影（card-surface），这里只负责
     去掉卡片底色、把悬停反馈换成品牌浅底。
     transform 的缓动属于 tilt（motion.ts）：必须写在这里，因为本规则带 Astro 作用域属性
     （.directory[data-astro-cid-*]，特异性 0,2,0）会压过 motion.css 里裸的 [data-tilt]（0,1,0），
     写在那边的 transition 实测永远不生效（计算值只剩 background-color）。 */
  .directory {
    background: transparent;
    transition:
      background-color 180ms ease,
      transform 160ms ease-out;
  }

  .directory:hover,
  .directory:focus-within {
    background: var(--brand-wash);
  }

  .directory-title-link {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .directory-title {
    min-width: 0;
  }

  .directory-title-link:hover,
  .directory:focus-within .directory-title-link {
    color: var(--brand-strong);
  }

  .directory-arrow {
    margin-top: 0.15em;
    color: var(--brand-strong);
    transition: transform 180ms ease;
  }

  .directory:hover .directory-arrow,
  .directory:focus-within .directory-arrow {
    transform: translateX(0.2rem);
  }

  .directory-with-cover {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
  }

  .directory-with-cover .post-cover {
    grid-column: 1;
    grid-row: 1;
    min-height: 10rem;
  }

  /* 行与行之间只用 padding-block 分隔（1.25rem），不再有 gap，也没有 1px 线：
     相邻两行得到 2.5rem 的呼吸，hover 的 --brand-wash 只盖住行本身。 */
  .directory-with-cover > div {
    grid-column: 2;
    grid-row: 1;
    padding: 1.25rem;
  }

  .directory:not(.directory-with-cover) > div {
    padding-block: 1.25rem;
    padding-inline: 1.5rem 1.25rem;
  }

  /* 描述是段落，量度跟正文同一把尺（--measure 40em，这里 16px → 640px）：
     不设上限时 16px 的中文在 ~780px 的行宽上会跑到 110+ 字/行。 */
  .directory p {
    max-width: var(--measure);
  }

  @media (max-width: 48rem) {
    .directory-with-cover {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }

    .directory-with-cover .post-cover {
      min-height: 9rem;
    }

    .directory-with-cover > div,
    .directory:not(.directory-with-cover) > div {
      padding: 1.25rem 0.75rem 1.25rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .directory {
      transition: none;
    }

    .directory-arrow {
      transition: none;
    }
  }
</style>
