---
import { Icon } from 'astro-icon/components';
import { categoryColor, tagSlug } from '../site.config';
import { formatDate, readingTime } from '../lib/utils';

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      date: Date;
      description?: string;
      tags: string[];
      categories: string[];
    };
  };
}

const { post } = Astro.props;
const href = `/posts/${post.id}/`;
const minutes = post.body ? readingTime(post.body) : null;
const category = post.data.categories[0];
const spine = categoryColor(category ?? '');
---

<article
  class="group relative overflow-hidden rounded-3xl border border-line bg-surface py-5 pr-5 pl-6 shadow-card transition-all hover:-translate-y-0.5 hover:shadow-card-hover sm:py-6 sm:pr-6 sm:pl-7"
>
  <span
    aria-hidden="true"
    class="absolute top-5 bottom-5 left-0 w-[5px] rounded-r-full"
    style={`background:${spine}`}
  />
  <h2 class="text-lg leading-snug sm:text-xl">
    <a
      href={href}
      class="text-ink transition-colors after:absolute after:inset-0 group-hover:text-wash-pink-deep"
    >
      {post.data.title}
    </a>
  </h2>

  <div class="mt-2.5 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-sub">
    {
      category && (
        <span class="rounded-full px-3 py-0.5 text-white" style={`background:${spine}`}>
          {category}
        </span>
      )
    }
    <span class="inline-flex items-center gap-1">
      <Icon name="material-symbols:calendar-month" class="size-3.5" />
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </span>
    {
      minutes && (
        <span class="inline-flex items-center gap-1">
          <Icon name="material-symbols:schedule" class="size-3.5" />
          约 {minutes} 分钟
        </span>
      )
    }
  </div>

  {
    post.data.description && (
      <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-sub">{post.data.description}</p>
    )
  }

  {
    post.data.tags.length > 0 && (
      <ul class="relative mt-3.5 flex flex-wrap gap-1.5" aria-label="标签">
        {post.data.tags.slice(0, 4).map((tag) => (
          <li>
            <a
              href={`/tags/${tagSlug(tag)}/`}
              class="inline-flex items-center rounded-full bg-surface-2 px-2.5 py-0.5 text-xs text-sub transition-colors hover:bg-accent-100 hover:text-accent-700"
            >
              # {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
