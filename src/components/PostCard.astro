---
import { Icon } from 'astro-icon/components';
import { tagSlug } from '../site.config';
import { formatDate, readingTime } from '../lib/utils';

interface Props {
  post: {
    id: string;
    body?: string;
    data: {
      title: string;
      date: Date;
      description?: string;
      tags: string[];
    };
  };
}

const { post } = Astro.props;
const href = `/posts/${post.id}/`;
const minutes = post.body ? readingTime(post.body) : null;
---

<article
  class="group relative rounded-2xl border border-neutral-200/70 bg-white p-5 shadow-card transition-shadow hover:shadow-card-hover sm:p-6 dark:border-neutral-800 dark:bg-neutral-800/40"
>
  <h2 class="text-lg font-semibold leading-snug sm:text-xl">
    <a
      href={href}
      class="text-neutral-900 transition-colors after:absolute after:inset-0 group-hover:text-accent-600 dark:text-neutral-100 dark:group-hover:text-accent-400"
    >
      {post.data.title}
    </a>
  </h2>

  <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-neutral-500 dark:text-neutral-400">
    <span class="inline-flex items-center gap-1">
      <Icon name="material-symbols:calendar-month" class="size-3.5" />
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </span>
    {
      minutes && (
        <span class="inline-flex items-center gap-1">
          <Icon name="material-symbols:schedule" class="size-3.5" />
          约 {minutes} 分钟
        </span>
      )
    }
  </div>

  {
    post.data.description && (
      <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
        {post.data.description}
      </p>
    )
  }

  {
    post.data.tags.length > 0 && (
      <ul class="relative mt-4 flex flex-wrap gap-1.5" aria-label="标签">
        {post.data.tags.map((tag) => (
          <li>
            <a
              href={`/tags/${tagSlug(tag)}/`}
              class="inline-flex items-center rounded-full bg-accent-50 px-2.5 py-0.5 text-xs text-accent-600 transition-colors hover:bg-accent-100 dark:bg-accent-900/40 dark:text-accent-300 dark:hover:bg-accent-900/70"
            >
              # {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
