---
import { Icon } from 'astro-icon/components';
import { SIDEBAR } from '../site.config';
---

<aside
  class="space-y-6 rounded-2xl border border-neutral-200/70 bg-white p-5 shadow-card dark:border-neutral-800 dark:bg-neutral-800/40"
>
  <section>
    <h2 class="mb-3 text-sm font-semibold text-neutral-500 dark:text-neutral-400">关于我</h2>
    <p class="text-sm leading-relaxed whitespace-pre-line text-neutral-600 dark:text-neutral-300">
      {SIDEBAR.description}
    </p>
  </section>

  <section>
    <h2 class="mb-3 text-sm font-semibold text-neutral-500 dark:text-neutral-400">社交</h2>
    <ul class="flex flex-wrap gap-2">
      {
        SIDEBAR.social.map((item) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener"
              aria-label={item.name}
              title={item.name}
              class="grid size-9 place-items-center rounded-full bg-neutral-100 text-neutral-500 transition-colors hover:bg-accent-100 hover:text-accent-600 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-accent-900/50 dark:hover:text-accent-300"
            >
              <Icon name={item.icon} class="size-4" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    SIDEBAR.friendLinks.length > 0 && (
      <section>
        <h2 class="mb-3 text-sm font-semibold text-neutral-500 dark:text-neutral-400">友情链接</h2>
        <ul class="space-y-1.5">
          {SIDEBAR.friendLinks.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener"
                class="text-sm text-neutral-600 transition-colors hover:text-accent-600 dark:text-neutral-300 dark:hover:text-accent-300"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</aside>
