---
// 文章皮肤：imas-album —— 专辑封面网格（旧站 imas-hires 贴的 album-grid 结构）。
// 旧机制：custom_css 注入 + 全局 album-blur.js + MutationObserver；
// 新机制：frontmatter `skin: imas-album` 挂载本组件，样式与脚本随之生效。
---

<style is:global>
  .album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 0.75rem;
    padding: 0.75rem 0;
  }

  .album-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* 封面：正方形 + 加载后解除模糊（克制版的“点击放大”前奏）
     height:auto 必须显式声明：旧 HTML 的 height=140 属性提示会压过 aspect-ratio */
  .album-grid .album-item img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 0.5rem;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.12);
    background: rgb(0 0 0 / 0.05);
    cursor: zoom-in;
    filter: blur(12px);
    transform: scale(1.05);
    transition:
      filter 0.5s ease,
      transform 0.5s ease,
      box-shadow 0.2s ease;
  }

  .album-grid .album-item img.album-loaded {
    filter: blur(0);
    transform: scale(1);
  }

  .album-grid .album-item img.album-loaded:hover {
    transform: scale(1.06);
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.2);
  }

  .album-item span {
    margin-top: 0.375rem;
    font-size: 0.7rem;
    line-height: 1.3;
    color: rgb(0 0 0 / 0.55);
    word-break: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :where(.dark) .album-item span {
    color: rgb(255 255 255 / 0.6);
  }

  /* 无封面占位 */
  .no-cover {
    aspect-ratio: 1 / 1;
    width: 100%;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, #e8e8e8, #d0d0d0);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
  }
</style>

<script>
  // capture 阶段监听 img 的 load/error（不冒泡），委托式处理所有专辑封面
  function reveal(img: HTMLImageElement) {
    img.classList.add('album-loaded');
  }

  document.addEventListener(
    'load',
    (event) => {
      const target = event.target;
      if (target instanceof HTMLImageElement && target.closest('.album-grid')) reveal(target);
    },
    true,
  );

  document.addEventListener(
    'error',
    (event) => {
      const target = event.target;
      if (target instanceof HTMLImageElement && target.closest('.album-grid')) reveal(target);
    },
    true,
  );

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLImageElement>('.album-grid img').forEach((img) => {
      if (img.complete && img.naturalWidth > 0) reveal(img);
    });
  });
</script>
