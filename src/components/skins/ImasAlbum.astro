---
// 文章皮肤：imas-album —— 专辑封面网格（旧站 imas-hires 贴的 album-grid 结构）。
// 旧机制：custom_css 注入 + 全局 album-blur.js + MutationObserver；
// 新机制：frontmatter `skin: imas-album` 挂载本组件，样式与脚本随之生效。
---

<style is:global>
  /* 收进 components 层：未分层样式会无条件压过 Tailwind 分层规则（曾导致 details 内边距失效） */
  @layer components {
    .album-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      gap: 0.75rem;
      padding: 0.75rem 0;
    }

  .album-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* 默认清晰：无 JavaScript 时不能让封面永久模糊；启用 JS 后才做加载过渡。 */
  .album-grid .album-item img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-media);
    box-shadow: var(--shadow-media);
    background: var(--surface-2);
    cursor: zoom-in;
    filter: none;
    transform: none;
    transition:
      filter 0.5s ease,
      transform 0.5s ease,
      box-shadow 0.2s ease;
  }

  .js .album-grid .album-item img {
    filter: blur(12px);
    transform: scale(1.05);
  }

  .js .album-grid .album-item img.album-loaded {
    filter: blur(0);
    transform: scale(1);
  }

  .album-grid .album-item img.album-loaded:hover {
    transform: scale(1.06);
    box-shadow: var(--shadow-media-hover);
  }

  .album-item span {
    margin-top: 0.375rem;
    font-size: 0.7rem;
    line-height: 1.3;
    color: var(--sub);
    word-break: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 无封面占位 */
  .no-cover {
    aspect-ratio: 1 / 1;
    width: 100%;
    border-radius: var(--radius-media);
    background: linear-gradient(135deg, var(--wash-sand), var(--wash-clay));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
  }
  }
</style>

<script>
  // capture 阶段监听 img 的 load/error（不冒泡），委托式处理所有专辑封面
  function reveal(img: HTMLImageElement) {
    img.classList.add('album-loaded');
  }

  document.documentElement.classList.add('js');

  document.addEventListener(
    'load',
    (event) => {
      const target = event.target;
      if (target instanceof HTMLImageElement && target.closest('.album-grid')) reveal(target);
    },
    true,
  );

  document.addEventListener(
    'error',
    (event) => {
      const target = event.target;
      if (target instanceof HTMLImageElement && target.closest('.album-grid')) reveal(target);
    },
    true,
  );

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLImageElement>('.album-grid img').forEach((img) => {
      if (img.complete && img.naturalWidth > 0) reveal(img);
    });
  });
</script>
