---
// 目录树的递归渲染。折叠形态下，含子节的一级节右侧多一个 toggle 按钮。
// 用 Astro.self 自引用 —— 递归发生在构建期，客户端拿到的就是一层层嵌套好的 <ul>。
import { Icon } from 'astro-icon/components';
import type { TocNode } from '../lib/toc';

interface Props {
  nodes: TocNode[];
  /** 是否渲染折叠开关（构建期按标题规模决定，短文章根本不渲染按钮） */
  collapsible: boolean;
  /** 子列表 id 前缀。桌面侧栏与移动卡片各渲染一份树，靠它避免 id 撞车 */
  idPrefix: string;
  /** 顶层列表自身的 id（由调用方决定是否需要） */
  listId?: string;
}

const { nodes, collapsible, idPrefix, listId } = Astro.props;
---

<ul class="toc-list" id={listId}>
  {
    nodes.map((node) => {
      const sublistId = `${idPrefix}-${node.slug}-sublist`;
      const hasChildren = node.children.length > 0;
      return (
        <li class="toc-item" data-toc-item data-toc-id={node.slug}>
          <a class="toc-link" href={`#${node.slug}`} data-toc-link>
            <span class="toc-text">{node.text}</span>
          </a>
          {collapsible && hasChildren && (
            <button
              type="button"
              class="toc-toggle"
              data-toc-toggle
              aria-expanded="false"
              aria-controls={sublistId}
              aria-label={`展开或收起「${node.text}」的子目录`}
            >
              <Icon
                name="material-symbols:keyboard-arrow-down"
                class="toc-toggle-icon"
                aria-hidden="true"
              />
            </button>
          )}
          {hasChildren && (
            <Astro.self
              nodes={node.children}
              collapsible={collapsible}
              idPrefix={idPrefix}
              listId={sublistId}
            />
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .toc-list {
    width: 100%;
    margin: 0;
    padding-left: 0;
    list-style: none;
  }

  /* 子列表跨两列：始终整行折到下一行。只有嵌套层才缩进：一级节紧贴竖线，每深一层加一档 */
  .toc-item > .toc-list {
    grid-column: 1 / -1;
    padding-left: 0.75rem;
  }

  /* 两列 grid：链接吃满剩余宽度、toggle 贴右独占第二列，二者永远同一行。
     之前是 flex-wrap + 链接 flex-grow —— 长标题吃满整行后把按钮挤到第二行
     （1440 实测 toggle 比链接低 29px）。第一列 minmax(0, 1fr) 让长标题在列内换行，
     而不是把整行撑宽；没有 toggle 的条目第二列为 0，左缘与有按钮的条目一致。
     改后实测 1920 / 1440 / 1024：toggleTop − linkTop = 2px（最长标题，含 2–3 行）。 */
  .toc-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  .toc-link {
    min-width: 0;
    padding: 0.3rem 0.75rem;
    color: var(--sub);
    font-size: 0.875rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .toc-link:hover {
    color: var(--ink);
  }

  .toc-item.is-active > .toc-link {
    color: var(--wash-pink-deep);
    font-weight: 500;
  }

  .toc-toggle {
    /* ::after 热区以本元素为参照；不要直接改 width/height —— 目录行之间没有空隙，
       按钮一变大就会挤行高、把整棵树的节奏改掉。 */
    position: relative;
    display: grid;
    /* 纵向钉在第一行：多行标题下行高 48.8 / 68.4，居中会让按钮顶边比链接顶边低
       12.4 / 22.2px。2px 让 24px 按钮的光学中心贴近首行 19.6px 的文字（差 0.6px）。 */
    align-self: start;
    margin-block-start: 2px;
    width: 1.5rem;
    height: 1.5rem;
    place-content: center;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: var(--sub);
    cursor: pointer;
    transition: color 160ms ease, background-color 160ms ease;
  }

  /* 视觉仍是 24px，纵向热区 ≈37px；横向不扩出右侧滚动容器 */
  .toc-toggle::after {
    content: '';
    position: absolute;
    inset: -0.4rem 0;
  }

  .toc-toggle:hover {
    background: var(--chip-bg);
    color: var(--ink);
  }

  .toc-toggle-icon {
    width: 1rem;
    height: 1rem;
    transition: transform 200ms ease;
  }

  /* 收起时箭头朝下（点开），展开时翻上来（收起） */
  .toc-item.is-open > .toc-toggle .toc-toggle-icon {
    transform: rotate(180deg);
  }

  /* 折叠态：只有一级节常驻，进入当前节时由脚本给它加 is-open。
     :global 是必需的 —— data-toc-collapse 挂在调用方容器（Toc.astro 的元素）上，
     不把它排除出作用域，这个选择器会被加上本组件的 scope 属性，就永远匹配不上了。 */
  :global([data-toc-collapse]) .toc-item:not(.is-open) > .toc-list {
    display: none;
  }
</style>
