---
import { Icon } from 'astro-icon/components';
---

<!-- 双态切换（dark-mode-toggle 指南）：两个状态都写进标记，显示哪个由 color-scheme 决定
     （meta 映射 + prefers-color-scheme），不靠 JS 维护图标；图标显示当前解析出的方案
     （亮色 = 太阳 / 暗色 = 月亮），隐藏项用 display: none 从无障碍树移除，按钮的可访问名
     就是当前可见的动作文案（例如「切换到深色主题」）。 -->
<button
  id="theme-toggle"
  type="button"
  class="grid size-11 place-items-center rounded-full text-sub transition-colors hover:bg-surface-2 hover:text-wash-pink-deep sm:size-9"
>
  <span class="theme-toggle-light items-center">
    <Icon name="material-symbols:light-mode" class="size-5" aria-hidden="true" />
    <span class="sr-only">切换到深色主题</span>
  </span>
  <span class="theme-toggle-dark items-center">
    <Icon name="material-symbols:dark-mode" class="size-5" aria-hidden="true" />
    <span class="sr-only">切换到浅色主题</span>
  </span>
</button>

<script>
  import { toggleTheme } from '../scripts/theme';

  // 事件委托挂 document 上，换页后依然生效；守卫挂 Document 对象而不是 <html> 的
  // data 属性 —— Astro 换页会清空 documentElement 的全部属性（bilibili.ts 有同样记录）。
  const binding = document as Document & { __serinaThemeClickBound?: boolean };
  if (!binding.__serinaThemeClickBound) {
    binding.__serinaThemeClickBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target?.closest('#theme-toggle')) return;
      toggleTheme();
    });
  }
</script>

<style>
  /* 默认两个都隐藏，由配色状态显式打开一个：meta 钉住时按 meta，未钉住（light dark）时
     按系统偏好。于是系统偏好变化、其它标签页改覆写时，图标不需要 JS 参与就已经是对的。 */
  .theme-toggle-light,
  .theme-toggle-dark {
    display: none;
  }
  :global(:root:has(> head > meta[name='color-scheme'][content='light'])) .theme-toggle-light,
  :global(:root:has(> head > meta[name='color-scheme'][content='dark'])) .theme-toggle-dark {
    display: inline-flex;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not(:has(> head > meta[name='color-scheme'][content='dark']))) .theme-toggle-light {
      display: inline-flex;
    }
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not(:has(> head > meta[name='color-scheme'][content='light']))) .theme-toggle-dark {
      display: inline-flex;
    }
  }
</style>
